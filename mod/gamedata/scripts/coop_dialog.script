--[[
	Anomaly Co-op: a conversation with an NPC is shared by both players.
	The talk runs in the game of the one who started it (the NPC's dialog actions, tasks and rewards happen there
	once). The co-op engine (r10/r11) hands every line (on_line) and every set of answers (on_options) to this
	script; they go to the partner, whose game opens a copy of the talk window: the same lines, the same answers.
	An answer chosen in the copy goes back and is said in the starter's window as if clicked there (r11).
	Trade, upgrades and repairs stay each player's own; either one may close the window - the starter's closing
	ends the talk for both, the partner's only its copy.
	A partner who cannot take the copy (busy in a window of its own) sees the talk as subtitles; Num5 shows the
	last one again.
--]]

local ENGINE = rawget(_G, "coop_engine_version") and coop_engine_version() or 0
local MAX_LINES = 7
local HISTORY_LINES = 14
local AFTER_MS = 15000  -- the subtitles stay this long after the talker closed the talk window
local PANEL = nil
local lines = {}        -- { text, until }: subtitles on screen
local history = {}      -- the last conversation, all of it
local last_other = nil
local declined = false  -- the partner's talk copy was closed here: no new one until that talk ends
local talking = false   -- this player's own talk window

------------------------------------------------------------------ the starter's side
-- engine r18: the engine sends the talk's lines, answers, choices and switches itself and hands the partner's here
local E18 = (rawget(_G, "coop_engine_version") and coop_engine_version() or 0) >= 18
function on_line(speaker, text, other)
	if E18 or not (coop_main.connected and db.actor) or not text or text == "" then return end
	coop_main.send("dlg", db.actor:character_name(), speaker or "", text, other or "")
end

-- the answers the talk window offers now: "id\ttext\n..." from the engine, and the NPC talked to
function on_options(other, list, npc_id)
	if coop_main.debug then
		coop_main.log(string.format("talk options here: %s, npc %s, connected %s", tostring(other), tostring(npc_id),
			tostring(coop_main.connected)))
	end
	if E18 or not (coop_main.connected and db.actor) then return end
	local args = { db.actor:character_name(), other or "", tostring(npc_id and coop_spawn.R(npc_id) or "") }
	for id, text in (list or ""):gmatch("([^\t\n]+)\t([^\n]*)\n") do
		args[#args + 1] = id
		args[#args + 1] = text
	end
	coop_main.send("dlg_opts", unpack(args))
end

local function picked(id)
	if not (db.actor and db.actor:is_talking() and id) then return end
	if rawget(_G, "coop_dialog_pick") then coop_dialog_pick(id) end
end
coop_main.on_event("dlg_pick", function(a) picked(a[1]) end)
function engine_pick(id) picked(id) end

------------------------------------------------------------------ the partner's copy of the talk window
-- the game's own talk window with the same NPC here, run by the partner's game (r11)
local function mirror_shown() return rawget(_G, "coop_talk_mirror_shown") and coop_talk_mirror_shown() end

-- a copy opens only over the plain game view: not over this player's own talk, inventory, PDA and the like
local function can_open()
	return ENGINE >= 11 and db.actor and db.actor:alive() and not db.actor:is_talking() and main_hud_shown()
end

-- the engine: an answer was chosen in the copy, or the copy closed (or went on to its own trade)
function on_mirror_pick(id)
	if not E18 then coop_main.send("dlg_pick", id) end
end

function on_mirror_closed(how)
	if how ~= "switch" then declined = true end
end

-- the engine: an answer the partner chose here opens a trade or upgrades - they open in the partner's game
function on_partner_switch(kind)
	if not E18 then coop_main.send("dlg_switch", kind) end
end

coop_main.on_event("dlg_switch", function(a)
	if mirror_shown() then coop_talk_mirror_switch(a[1] or "trade") end
end)
function engine_switch(kind)
	if mirror_shown() then coop_talk_mirror_switch(kind or "trade") end
end

------------------------------------------------------------------ the partner's lines and answers arrive
local said = {}          -- the current talk's lines as said: { speaker, text, npc } (a copy opened late shows them)

local function add_subtitle(text)
	lines[#lines + 1] = { text, math.huge }
	while #lines > MAX_LINES do table.remove(lines, 1) end
end

local function add(text)
	history[#history + 1] = text
	while #history > HISTORY_LINES do table.remove(history, 1) end
	if not mirror_shown() then add_subtitle(text) end
end

local function new_talk(who, other)
	if other == last_other and (#lines > 0 or mirror_shown()) then return end
	last_other = other
	history = {}
	said = {}
	add(string.format("%%c[255,240,200,120]%s говорит с %s%%c[default]", who, other))
end

local function partner_line(a)
	if not db.actor then return end
	local who, speaker, text, other = a[1] or "", a[2] or "", a[3] or "", a[4] or ""
	if #text > 400 then text = text:sub(1, 397) .. "..." end
	new_talk(who, other)
	local color = speaker == other and "%c[255,200,200,190]" or "%c[255,150,210,255]"
	add(string.format("%s%s:%%c[default] %s", color, speaker, text))
	said[#said + 1] = { speaker, text, other }
	-- in the copy the partner's lines stand on this player's side, as in the partner's own window
	if mirror_shown() then coop_talk_mirror_line(speaker, text, speaker ~= other) end
end
coop_main.on_event("dlg", partner_line)
function engine_line(who, speaker, text, other) partner_line({ who, speaker, text, other }) end

local function partner_options(who, other, npc, list)
	if coop_main.debug then coop_main.log("talk options from the partner: " .. tostring(other) .. ", npc " .. tostring(npc)) end
	if not db.actor then return end
	local a = { who, other, tostring(npc) }
	new_talk(who, other)
	if not mirror_shown() and not declined then
		local obj = npc and level.object_by_id(npc)
		coop_main.log(string.format("talk copy: npc %s -> %s (%s), engine %d, talking %s, hud %s", tostring(a[3]),
			tostring(npc), obj and obj:section() or "not here", ENGINE, tostring(db.actor:is_talking()),
			tostring(main_hud_shown())))
	end
	if not mirror_shown() and not declined and npc and can_open() and coop_talk_mirror_open(npc) then
		coop_main.log("talk copy opened")
		-- the copy starts with what was said so far
		lines = {}
		for _, l in ipairs(said) do coop_talk_mirror_line(l[1], l[2], l[1] ~= l[3]) end
	end
	if mirror_shown() then coop_talk_mirror_options(table.concat(list)) end
end
coop_main.on_event("dlg_opts", function(a)
	local list = {}
	for i = 4, #a - 1, 2 do list[#list + 1] = a[i] .. "\t" .. (a[i + 1] or "") .. "\n" end
	partner_options(a[1] or "", a[2] or "", coop_spawn.L(a[3]), list)
end)
-- r18: the answers as the engine has them ("id\ttext\n..."), the NPC's id here
function engine_options(who, other, npc, text)
	local list = {}
	for line in tostring(text):gmatch("[^\n]+\n?") do list[#list + 1] = line:sub(-1) == "\n" and line or (line .. "\n") end
	partner_options(who or "", other or "", npc and npc >= 0 and npc or nil, list)
end

-- the starter closed its talk window: the copy closes, the subtitles go after a while
local function talk_over()
	if mirror_shown() then coop_talk_mirror_close() end
	declined = false
	local at = time_global() + AFTER_MS
	for _, l in ipairs(lines) do
		if l[2] > at then l[2] = at end
	end
end
coop_main.on_event("dlg_end", talk_over)
function engine_end() talk_over() end

-- Num5: the whole last conversation again, for a while
coop_main.on_event("_cmd_talk", function()
	if #history == 0 then
		coop_main.msg("Разговоров напарника пока не было")
		return
	end
	lines = {}
	local at = time_global() + 30000
	for _, text in ipairs(history) do lines[#lines + 1] = { text, at } end
end)

------------------------------------------------------------------ subtitles
class "UICoopTalk" (CUIScriptWnd)

function UICoopTalk:__init() super()
	local xml = utils_xml.get_hud_xml()
	self.text = xml:InitTextWnd("companion_list:slot:distance", self)
	local ok, font = pcall(function() return GetFontLetterica16Russian() end)
	self.text:SetFont(ok and font or GetFontSmall())
	self.text:SetTextComplexMode(true)
	self.text:SetWndPos(vector2():set(30, 300))
	self.text:SetWndSize(vector2():set(560, 330))
	self.text:SetTextAlignment(0)
	self.text:SetVTextAlignment(0)
	self.shown_text = nil
end

function UICoopTalk:__finalize() end

function UICoopTalk:Update()
	CUIScriptWnd.Update(self)
	local now = time_global()
	local keep = {}
	for _, l in ipairs(lines) do
		if l[2] > now then keep[#keep + 1] = l end
	end
	lines = keep
	local text = ""
	if #lines > 0 and main_hud_shown() then
		local parts = {}
		for _, l in ipairs(lines) do parts[#parts + 1] = l[1] end
		text = table.concat(parts, "\\n")
	end
	if text ~= self.shown_text then
		self.shown_text = text
		self.text:SetText(text)
	end
end

------------------------------------------------------------------ callbacks
-- this player's talk window closing tells the partner the conversation is over
local function actor_on_update()
	local now_talking = db.actor:is_talking() and not mirror_shown()
	if talking and not now_talking and coop_main.connected then
		if E18 then coop_talk_end() else coop_main.send("dlg_end") end
	end
	talking = now_talking
end

local function show_panel()
	if PANEL or not get_hud() then return end
	PANEL = UICoopTalk()
	get_hud():AddDialogToRender(PANEL)
end

local function hide_panel()
	if PANEL then
		get_hud():RemoveDialogToRender(PANEL)
		PANEL = nil
	end
	lines = {}
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", show_panel)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", hide_panel)
end
