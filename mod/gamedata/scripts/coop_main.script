--[[
	Anomaly Co-op: core module.
	Talks to CoopBridge.exe through two text files in appdata:
	  coop_out.txt  game -> bridge (rewritten every tick)
	  coop_in.txt   bridge -> game (rewritten by the bridge)
	Both files end with an "end" line; a file without it is a partial write and is skipped.
	v2.9: the launcher names a shared memory block in coop_in.txt (m|<name>); once the game opens it through LuaJIT FFI,
	the same frames go through it instead (no disk, the partner's state is taken the frame it arrives), see GameLink.cs.
	Line kinds:
	  g|<sid>|<ack>|<ver>|<role>   header written by the game (ack = last bridge event applied)
	  b|<sid>|<ack>|<role>|<connected>|<peer name>|<my name>|<beat>   header written by the bridge (beat changes every write)
	  s|<tag>|...                  state, latest value wins
	  e|<id>|<type>|...            reliable event, resent until acked
	Event types starting with "@" are handled by the bridge itself.
--]]

VERSION = "2.9"
debug = false
local TICK_MS = 100
local FAST_MS = 50       -- states marked fast (the partner's position) go both ways twice as often

local path_out, path_in
local sid = nil
local out_seq, out_queue = 0, {}
local in_sid, in_last = nil, 0
local next_tick, next_fast = 0, 0

------------------------------------------------------------------ shared memory with the launcher (v2.9)
-- layout and protocol in launcher\GameLink.cs: channel 0 game -> launcher, channel 1 launcher -> game,
-- two slots each, frame n in slot n % 2, seq written last
local SHM_SLOT = 512 * 1024
local SHM_CHAN = 64 + 2 * SHM_SLOT
local shm = nil          -- the open block: { ffi, handle, view, base, event, seq_in, seq_out, last_in }
local shm_tried = nil    -- the last block name tried (a new launcher run brings a new one)

------------------------------------------------------------------ the link in the engine (r8), without the launcher
-- the engine keeps the connection itself (coop_link.cpp) and swaps with the script the same frames as the files.
-- Until the in-game menu, appdata\coop_link.txt starts it: "host 27015" or "join 1.2.3.4 27015", "name Nick"
local ENGINE = rawget(_G, "coop_engine_version") and coop_engine_version() or 0
local link_on = false

local function start_link()
	if ENGINE < 8 then return end
	if coop_link_status() ~= "idle" then
		link_on = true -- kept across level loads
		return
	end
	local f = io.open(getFS():update_path("$app_data_root$", "coop_link.txt"), "r")
	if not f then return end
	local mode, addr, port, name
	for line in f:lines() do
		local k, a, b = line:match("^%s*(%a+)%s+(%S+)%s*(%S*)")
		if k == "host" then mode, port = "host", tonumber(a)
		elseif k == "join" then mode, addr, port = "join", a, tonumber(b)
		elseif k == "name" then name = line:match("^%s*name%s+(.-)%s*$") end
	end
	f:close()
	name = name or "Stalker"
	if mode == "host" then link_on = coop_link_host(port or 27015, name, VERSION)
	elseif mode == "join" and addr then link_on = coop_link_join(addr, port or 27015, name, VERSION) end
	log("engine link: " .. tostring(mode) .. " " .. tostring(addr or "") .. " " .. tostring(port) .. " -> " .. coop_link_status())
end

-- the main menu (coop_menu.script) starts a test's or a returning player's link before any game is loaded
function start_link_from_menu() start_link() end

local function shm_ffi()
	local ffi = rawget(_G, "ffi")
	if not ffi then
		local ok, m = pcall(require, "ffi")
		ffi = ok and m or nil
	end
	if not ffi then return nil end
	-- each on its own: another mod may have declared some of them already
	for _, d in ipairs({
		"void* OpenFileMappingA(uint32_t access, int inherit, const char* name);",
		"void* MapViewOfFile(void* h, uint32_t access, uint32_t off_hi, uint32_t off_lo, size_t n);",
		"int UnmapViewOfFile(const void* p);",
		"int CloseHandle(void* h);",
		"void* OpenEventA(uint32_t access, int inherit, const char* name);",
		"int SetEvent(void* h);",
	}) do pcall(ffi.cdef, d) end
	return ffi
end

local function shm_open(name)
	local ffi = shm_ffi()
	if not ffi then
		log("launcher link: files (no FFI in this exe)")
		return
	end
	local ok, err = pcall(function()
		local C = ffi.C
		local h = C.OpenFileMappingA(0xF001F, 0, name) -- FILE_MAP_ALL_ACCESS
		if h == nil then error("no block " .. name) end
		local view = C.MapViewOfFile(h, 0xF001F, 0, 0, 64 + 2 * SHM_CHAN)
		if view == nil then
			C.CloseHandle(h)
			error("cannot map " .. name)
		end
		local base = ffi.cast("uint8_t*", view)
		local head = ffi.cast("uint32_t*", base)
		if head[0] ~= 0x314F4341 or head[1] ~= SHM_SLOT then
			C.UnmapViewOfFile(view)
			C.CloseHandle(h)
			error("unknown block layout")
		end
		local ev = C.OpenEventA(0x0002, 0, name .. "_out") -- EVENT_MODIFY_STATE
		shm = { ffi = ffi, handle = h, view = view, base = base, event = ev, seq_in = 0,
			seq_out = ffi.cast("uint32_t*", base + 64)[0], last_in = time_global() }
	end)
	log("launcher link: " .. (ok and ("shared memory " .. name) or ("files (" .. tostring(err) .. ")")))
end

local function shm_close(why)
	if not shm then return end
	local s = shm
	shm = nil
	pcall(function()
		local C = s.ffi.C
		C.UnmapViewOfFile(s.view)
		C.CloseHandle(s.handle)
		if s.event ~= nil then C.CloseHandle(s.event) end
	end)
	log("launcher link: back to files (" .. why .. ")")
end

-- the launcher's newest frame, or nil when nothing new came
local function shm_read()
	local ffi, chan = shm.ffi, shm.base + 64 + SHM_CHAN
	local head = ffi.cast("uint32_t*", chan)
	local seq = head[0]
	if seq == shm.seq_in then return nil end
	local slot = seq % 2
	local len = head[1 + slot]
	if len > SHM_SLOT then return nil end
	local raw = ffi.string(chan + 64 + slot * SHM_SLOT, len)
	if head[0] ~= seq then return nil end -- written twice meanwhile: the next frame takes it
	shm.seq_in = seq
	return raw
end

-- false when the frame does not fit (it goes by file then)
local function shm_write(text)
	if #text > SHM_SLOT then return false end
	local ffi, chan = shm.ffi, shm.base + 64
	local seq = (shm.seq_out + 1) % 4294967296
	local slot = seq % 2
	ffi.copy(chan + 64 + slot * SHM_SLOT, text, #text)
	local head = ffi.cast("uint32_t*", chan)
	head[1 + slot] = #text
	head[0] = seq
	shm.seq_out = seq
	if shm.event ~= nil then ffi.C.SetEvent(shm.event) end
	return true
end

-- shared session info, read by other coop_* modules
role = "none"          -- "host" | "client" | "none" (from bridge)
connected = false
peer_name = ""
my_name = ""
bridge_alive = false
local last_in_change, last_in_raw = 0, nil

local event_handlers = {}
local state_handlers = {}
local state_providers = {}
local fast_tags = {}          -- tag -> true for states read and written every FAST_MS
local state_lines = {}        -- tag -> the line written last; slow states are kept between full ticks

function esc(s)
	s = tostring(s or "")
	return (s:gsub("[|\r\n]", " "))
end

function split(s)
	local t = {}
	for part in (s.."|"):gmatch("([^|]*)|") do t[#t+1] = part end
	return t
end

function on_event(typ, fn)
	event_handlers[typ] = event_handlers[typ] or {}
	table.insert(event_handlers[typ], fn)
end

function on_state(tag, fn, fast)
	state_handlers[tag] = fn
	if fast then fast_tags[tag] = true end
end

-- fn() returns a list of fields (without "s|tag") or nil; fast = called every FAST_MS, not every TICK_MS
function add_state_provider(tag, fn, fast)
	state_providers[tag] = fn
	if fast then fast_tags[tag] = true end
end

-- queue a reliable event for the partner (or the bridge when typ starts with "@")
function send(typ, ...)
	out_seq = out_seq + 1
	local parts = {...}
	for i = 1, #parts do parts[i] = esc(parts[i]) end
	local line = "e|" .. out_seq .. "|" .. esc(typ)
	if #parts > 0 then line = line .. "|" .. table.concat(parts, "|") end
	out_queue[#out_queue+1] = { out_seq, line }
end

function msg(text, header, icon)
	if not db.actor then return end
	db.actor:give_game_news(header or "Кооператив", text, icon or "ui_inGame2_PD_Lider", 0, 6000)
	xr_sound.set_sound_play(AC_ID, "pda_tips")
end

local log_path
function log(s)
	log_path = log_path or getFS():update_path("$app_data_root$", "coop_log.txt")
	local f = io.open(log_path, "a")
	if f then
		f:write(string.format("[%d] %s\n", time_global(), tostring(s)))
		f:close()
	end
end

local function write_out(full)
	local lines = { "g|" .. sid .. "|" .. in_last .. "|" .. VERSION }
	for tag, fn in pairs(state_providers) do
		if full or fast_tags[tag] then
			local ok, fields = pcall(fn)
			if ok and fields then
				for i = 1, #fields do fields[i] = esc(fields[i]) end
				state_lines[tag] = "s|" .. tag .. "|" .. table.concat(fields, "|")
			else
				state_lines[tag] = nil
				if not ok then log("state provider " .. tag .. " failed: " .. tostring(fields)) end
			end
		end
		if state_lines[tag] then lines[#lines+1] = state_lines[tag] end
	end
	for i = 1, #out_queue do lines[#lines+1] = out_queue[i][2] end
	lines[#lines+1] = "end\n"
	local text = table.concat(lines, "\n")
	if link_on then
		coop_link_out(text)
		return
	end
	if shm and shm_write(text) then return end
	local f = io.open(path_out, "w")
	if f then
		f:write(text)
		f:close()
	end
end

local function dispatch_event(typ, args)
	local list = event_handlers[typ]
	if not list then return end
	for i = 1, #list do
		local ok, err = pcall(list[i], args)
		if not ok then log("event " .. typ .. " failed: " .. tostring(err)) end
	end
end

-- true when a frame was taken
local function read_in(full)
	local raw
	if link_on then
		raw = coop_link_in()
		if not raw then return false end
	elseif shm then
		raw = shm_read()
		if not raw then
			-- the launcher writes at least every 100 ms; silence = it closed (a new run brings a new block by file)
			if time_global() - shm.last_in > 3000 then shm_close("the launcher stopped writing") end
			return false
		end
		shm.last_in = time_global()
	else
		local f = io.open(path_in, "r")
		if not f then
			bridge_alive = false
			return false
		end
		raw = f:read("*a")
		f:close()
	end
	if not raw or not raw:find("\nend") then return false end -- partial write

	local now = time_global()
	if raw ~= last_in_raw then
		last_in_raw = raw
		last_in_change = now
	end
	-- the bridge rewrites the file at least every 500 ms; stale file = bridge closed
	bridge_alive = (now - last_in_change) < 3000

	local was_connected = connected
	for line in raw:gmatch("[^\n]+") do
		local t = split(line)
		local k = t[1]
		if k == "b" then
			if t[2] ~= in_sid then
				in_sid = t[2]
				in_last = 0
			end
			local ack = tonumber(t[3]) or 0
			local keep = {}
			for i = 1, #out_queue do
				if out_queue[i][1] > ack then keep[#keep+1] = out_queue[i] end
			end
			out_queue = keep
			role = t[4] or "none"
			connected = bridge_alive and (t[5] == "1")
			peer_name = t[6] or ""
			if t[7] and t[7] ~= "" then my_name = t[7] end
		elseif k == "s" then
			local fn = state_handlers[t[2]]
			if fn and (full or fast_tags[t[2]]) then
				local args = {}
				for i = 3, #t do args[#args+1] = t[i] end
				local ok, err = pcall(fn, args)
				if not ok then log("state " .. t[2] .. " failed: " .. tostring(err)) end
			end
		elseif k == "m" then
			if not shm and t[2] and t[2] ~= shm_tried then
				shm_tried = t[2]
				shm_open(t[2])
			end
		elseif k == "e" then
			local id = tonumber(t[2]) or 0
			if id > in_last then
				in_last = id
				local args = {}
				for i = 4, #t do args[#args+1] = t[i] end
				dispatch_event(t[3], args)
			end
		end
	end

	if connected ~= was_connected then
		if connected then
			msg(string.format("Подключён %s (вы %s)", peer_name, role == "host" and "хост" or "гость"))
		else
			msg("Напарник отключился")
		end
		dispatch_event("_connection", { connected and "1" or "0" })
	end
	return true
end

local next_tick_in = 0
local function actor_on_update()
	local now = time_global()
	-- through shared memory a frame is taken the moment it comes (states other than fast ones still every TICK_MS)
	if shm or link_on then
		local full_in = now >= next_tick_in
		if read_in(full_in) and full_in then next_tick_in = now + TICK_MS end
	end
	if now < next_fast then return end
	next_fast = now + FAST_MS
	local full = now >= next_tick
	if full then next_tick = now + TICK_MS end
	if not (shm or link_on) then read_in(full) end
	write_out(full)
end

function is_host() return connected and role == "host" end
function is_client() return connected and role == "client" end

------------------------------------------------------------------ hotkeys
-- defaults; CoopLauncher writes the player's choice to appdata\coop_keys.txt ("tp=DIK_NUMPAD1")
local keys = { tp = "DIK_NUMPAD1", sync = "DIK_NUMPAD2", load = "DIK_NUMPAD3", status = "DIK_NUMPAD0", give = "DIK_NUMPAD4" }
local options = nil          -- launcher options from the same file ("rewards=1")

local function load_keys()
	options = {}
	local f = io.open(getFS():update_path("$app_data_root$", "coop_keys.txt"), "r")
	if not f then return end
	for line in f:lines() do
		local action, dik = line:match("^%s*(%w+)%s*=%s*(DIK_[%w_]+)")
		if action and keys[action] and DIK_keys[dik] then keys[action] = dik end
		local name, v = line:match("^%s*(%w+)%s*=%s*(%d+)%s*$")
		if name then options[name] = v ~= "0" end
	end
	f:close()
end

-- the co-op menu changed coop_keys.txt
function reload_options() options = nil end

-- launcher option (true/false); def when the launcher did not write it
function option(name, def)
	if not options then load_keys() end
	local v = options[name]
	if v == nil then return def end
	return v
end

-- "DIK_NUMPAD3" -> "Num3" for messages
function key_name(action)
	local k = (keys[action] or ""):gsub("^DIK_", "")
	return (k:gsub("^NUMPAD", "Num"))
end

local function on_key_press(key)
	if key == DIK_keys[keys.tp] then
		dispatch_event("_cmd_tp", {})
	elseif key == DIK_keys[keys.sync] then
		dispatch_event("_cmd_sync", {})
	elseif key == DIK_keys[keys.load] then
		dispatch_event("_cmd_load", {})
	elseif key == DIK_keys[keys.give] then
		dispatch_event("_cmd_give", {})
	elseif key == DIK_keys[keys.status] then
		if not bridge_alive then
			msg("Лаунчер кооператива не запущен")
		elseif not connected then
			msg("Лаунчер запущен, ждём напарника")
		else
			msg(string.format("Напарник: %s, вы %s", peer_name, role == "host" and "хост" or "гость"))
		end
	end
end

-- what the launcher's window would show, from the engine link
on_event("note", function(a) msg(a[1] or "") end)

-- commands typed into the bridge window arrive as "cmd" events
on_event("cmd", function(a) dispatch_event("_cmd_" .. (a[1] or ""), { a[2], a[3], a[4] }) end)
on_event("chat", function(a) msg(a[1] or "", a[2] or peer_name, "ui_inGame2_PD_Lider") end)
on_event("info", function(a) msg(a[1] or "") end)

-- Anomaly answers a script error inside an engine call with a "tempsave", then reloads it: in a co-op session that
-- breaks the session, and a save made while an object is half spawned crashes the game. Log it and play on instead.
local function hook_fatal_window()
	local orig = rawget(_G, "COnLuaBindFatalError")
	if not orig or rawget(_G, "coop_fatal_hooked") then return end
	_G.coop_fatal_hooked = true
	_G.COnLuaBindFatalError = function(offender)
		if not connected then return orig(offender) end
		log("script error inside an engine call (no tempsave in co-op): " .. tostring(offender))
		msg("Ошибка скрипта, подробности в coop_log.txt")
	end
end

function on_game_start()
	hook_fatal_window()
	path_out = getFS():update_path("$app_data_root$", "coop_out.txt")
	path_in = getFS():update_path("$app_data_root$", "coop_in.txt")
	local dbgf = io.open(getFS():update_path("$app_data_root$", "coop_debug.txt"), "r")
	debug = dbgf ~= nil
	if dbgf then dbgf:close() end
	local f = io.open(getFS():update_path("$app_data_root$", "coop_log.txt"), "w")
	if f then f:write("Anomaly Co-op " .. VERSION .. " log\n"); f:close() end
	math.randomseed(os.time() + math.floor(os.clock() * 1000))
	sid = tostring(math.random(100000, 999999))
	out_seq, out_queue, in_sid, in_last = 0, {}, nil, 0
	RegisterScriptCallback("actor_on_update", actor_on_update)
	load_keys()
	start_link()
	RegisterScriptCallback("on_key_press", on_key_press)
end
