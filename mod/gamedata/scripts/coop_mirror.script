--[[
	Anomaly Co-op: the guest's world near the players is the host's (the "mirror", v2.14).
	Each game runs its own simulation, so between reloads the people and creatures around the guest drift from
	the host's: one has a bandit the other has not, a squad walked elsewhere. Every 1.5 s the host sends every
	creature near either player (state "wm"); the guest makes its world the same:
	  - one the host has and the guest has not: made (in its squad, as a new spawn from the host is), or brought
	    back from wherever the guest's simulation took it;
	  - one the host has dead and the guest alive: killed;
	  - one of the guest's own the host has not: gone (only where the host surely has its world online - near
	    both players - and never a story character).
	Positions, poses and health of those it has are set by coop_world ("n") as before.
	  host -> guest:  "wm"  stamp, level, host position, then id:section:x:y:z:lvid:gvid:alive:squad:squad section:smart
--]]

local SEND_MS = 1500
local RADIUS = 130           -- host: creatures this near either player
local NEAR_GUEST = 110       -- guest: made or removed only this near this player (inside the host's radius)
local NEAR_HOST = 110        -- guest: removed only this near the host too (its world is online there)
local MAKE_PER_TICK = 3      -- a few at a time: making creatures costs a frame
local RELEASE_PER_TICK = 5
local MISSES = 2             -- removed after this many lists in a row without it (a spawn may be on its way)

local ready_at = nil
local next_send = 0
local last_stamp = nil
local missing = {}           -- guest: local id -> lists in a row that did not have it
local made_at = {}           -- guest: local id -> when the mirror made or moved it (left alone for a while)
local stats = { made = 0, moved = 0, killed = 0, removed = 0 }

local function dbg(s) if coop_main.debug then coop_main.log("mirror: " .. s) end end
local function is_creature(obj) return obj and (IsStalker(obj) or IsMonster(obj)) end
local function f1(n) return string.format("%.1f", n) end

function get_stats() return stats end

------------------------------------------------------------------ host: what is around the players
coop_main.add_state_provider("wm", function()
	if not (coop_main.is_host() and coop_main.connected and db.actor) then return end
	local now = time_global()
	if now < next_send then return end -- nil = keep the last list on the bridge
	next_send = now + SEND_MS
	local apos = db.actor:position()
	local remote = coop_player.get_remote()
	local rpos = remote and remote.level == level.name() and remote.pos
	local list = { tostring(now), level.name(), f1(apos.x), f1(apos.y), f1(apos.z) }
	for id, st in pairs(db.storage) do
		local obj = st.object
		if obj and id ~= AC_ID and is_creature(obj) and not coop_player.is_puppet(id) then
			local p = obj:position()
			if p:distance_to(apos) < RADIUS or (rpos and p:distance_to(rpos) < RADIUS) then
				local squad = obj:alive() and get_object_squad(obj)
				list[#list + 1] = string.format("%d:%s:%s:%s:%s:%d:%d:%d:%s:%s:%s", id, obj:section(), f1(p.x), f1(p.y), f1(p.z),
					obj:level_vertex_id(), obj:game_vertex_id(), obj:alive() and 1 or 0, squad and squad.id or "",
					squad and squad:section_name() or "", squad and squad.smart_id or "")
			end
		end
	end
	return list
end)

------------------------------------------------------------------ guest: the same here
local function vec(x, y, z) return vector():set(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0) end

-- a story character, or one of a story squad: never removed here
local function story(obj)
	if get_object_story_id(obj:id()) then return true end
	local squad = get_object_squad(obj)
	return squad ~= nil and get_object_story_id(squad.id) ~= nil
end

local function apply(t)
	local here = db.actor:position()
	local host_pos = vec(t[3], t[4], t[5])
	local now = time_global()
	local listed, made, moved, killed = {}, 0, 0, 0
	for i = 6, #t do
		local hid, sec, x, y, z, lvid, gvid, alive, sq, sq_sec, smart =
			t[i]:match("^(%d+):([^:]+):([^:]+):([^:]+):([^:]+):(%d+):(%d+):(%d):(%d*):([^:]*):(%d*)$")
		hid = tonumber(hid)
		if hid then
			listed[hid] = true
			local pos = vec(x, y, z)
			local id = coop_spawn.L(hid)
			local obj = id and level.object_by_id(id)
			if obj and obj:section() == sec then
				if alive == "0" and obj:alive() then
					obj:kill(obj)
					killed = killed + 1
				end
			elseif alive == "1" and pos:distance_to(here) < NEAR_GUEST then
				local se = id and alife_object(id)
				if se and se:section_name() == sec then
					-- the guest's simulation has it elsewhere (offline): back to where the host has it
					if not made_at[id] or now - made_at[id] > 10000 then
						TeleportObject(id, pos, tonumber(lvid), tonumber(gvid))
						made_at[id] = now
						moved = moved + 1
					end
				elseif made < MAKE_PER_TICK then
					local gid = coop_spawn.make_creature(tonumber(sq), sq_sec ~= "" and sq_sec or nil, hid, sec, pos,
						tonumber(lvid), tonumber(gvid), tonumber(smart))
					if gid then
						made_at[gid] = now
						made = made + 1
					end
				end
			end
		end
	end

	-- the guest's own: what the host does not have, near both players
	local released = 0
	local seen = {}
	for id, st in pairs(db.storage) do
		local obj = st.object
		if obj and id ~= AC_ID and is_creature(obj) and obj:alive() and not coop_player.is_puppet(id) then
			local p = obj:position()
			if p:distance_to(here) < NEAR_GUEST and p:distance_to(host_pos) < NEAR_HOST
				and not listed[coop_spawn.R(id)] and not story(obj)
				and not (made_at[id] and now - made_at[id] < 10000) then
				seen[id] = true
				missing[id] = (missing[id] or 0) + 1
				if missing[id] >= MISSES and released < RELEASE_PER_TICK then
					dbg(string.format("not at the host: %s %d", obj:section(), id))
					coop_spawn.release_creature(id)
					released = released + 1
				end
			end
		end
	end
	for id in pairs(missing) do
		if not seen[id] then missing[id] = nil end
	end

	stats.made, stats.moved = stats.made + made, stats.moved + moved
	stats.killed, stats.removed = stats.killed + killed, stats.removed + released
	if made + moved + killed + released > 0 then
		dbg(string.format("made %d, brought back %d, killed %d, removed %d (host lists %d)", made, moved, killed, released,
			#t - 5))
	end
end

coop_main.on_state("wm", function(t)
	if not (coop_main.is_client() and coop_session.is_guest_session() and db.actor) then return end
	if t[1] == last_stamp or not ready_at or time_global() < ready_at then return end
	last_stamp = t[1]
	-- the host elsewhere (another level, or this game still on the way): nothing to compare
	if t[2] ~= level.name() then return end
	local ok, err = pcall(apply, t)
	if not ok then coop_main.log("mirror failed: " .. tostring(err)) end
end)

local function actor_on_first_update()
	-- the guest's character and the host's spawns settle first
	ready_at = time_global() + 10000
end

function on_game_start()
	ready_at, last_stamp, missing, made_at = nil, nil, {}, {}
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
