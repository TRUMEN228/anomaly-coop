--[[
	Anomaly Co-op: doors, breakable objects and traders (v2.0).
	  both ways:      "door"   a scripted door opened/closed (ph_door)
	                  "pbreak" a breakable crate/object was destroyed (its loot comes from the host as "wspawn")
	                  "tbuy"   the actor bought an item from a trader -> the same item leaves the partner's trader
	                  "tsell"  the actor sold an item -> the partner's trader gets it too
	  guest -> host:  "treq"   the guest started talking to an NPC: send that NPC's goods
	  host -> guest:  "tstock" a trader's goods and money; the guest's own restocks are switched off
	  host -> guest:  "tmark"  a reward stash was marked (PDA spot + its lazy contents)
	  guest -> host:  "tspawn" the guest opened a stash first: the host spawns its contents too (once)
	                  "pstash" the actor made a stash from a backpack ("pstash_map" returns the host id)
	                  "surr"   a wounded NPC surrendered to the actor
	                  "pd"     state: angles of push doors that the player moved
--]]

local applying = false
local talking_to = nil       -- id of the NPC the actor last used (trade partner)
local ready_at = nil         -- doors initialise themselves while a level loads: ignore that

local function host() return coop_main.is_host() end
local function guest() return coop_session.is_guest_session() end
local function dbg(s) if coop_main.debug then coop_main.log("objects: " .. s) end end
local L, R = function(x) return coop_spawn.L(x) end, function(x) return coop_spawn.R(x) end

------------------------------------------------------------------ doors
local function on_door(action, open)
	if applying or not coop_main.connected or not (action and action.object) then return end
	if not ready_at or time_global() < ready_at then return end
	coop_main.send("door", R(action.object:id()), open and 1 or 0)
end

local function hook_doors()
	local cls = ph_door and ph_door.action_door
	if not cls or rawget(_G, "coop_doors_hooked") then return end
	_G.coop_doors_hooked = true
	local open, close = cls.open_door, cls.close_door
	cls.open_door = function(self, disable_snd)
		open(self, disable_snd)
		pcall(on_door, self, true)
	end
	cls.close_door = function(self, disable_snd)
		close(self, disable_snd)
		pcall(on_door, self, false)
	end
end

coop_main.on_event("door", function(a)
	local id = L(a[1])
	local st = id and db.storage[id] and db.storage[id].ph_door
	local action = st and st.door_action
	if not action then return end
	applying = true
	local ok, err = pcall(function() if a[2] == "1" then action:open_door(true) else action:close_door(true) end end)
	applying = false
	dbg("door " .. id .. (a[2] == "1" and " opened" or " closed") .. (ok and "" or (" failed " .. tostring(err))))
end)

------------------------------------------------------------------ breakable objects
local function hook_breakables()
	local cls = bind_physic_object and bind_physic_object.generic_physics_binder
	if not cls or rawget(_G, "coop_breakables_hooked") then return end
	_G.coop_breakables_hooked = true
	local death = cls.death_callback
	cls.death_callback = function(self, victim, who)
		if not applying and coop_main.connected and victim then
			pcall(coop_main.send, "pbreak", R(victim:id()), victim:section())
		end
		return death(self, victim, who)
	end
end

coop_main.on_event("pbreak", function(a)
	local obj = level.object_by_id(L(a[1]) or -1)
	if not (obj and obj:section() == a[2]) then return end
	applying = true
	pcall(function()
		local h = hit()
		h.type = hit.explosion
		h.power = 1000
		h.impulse = 0
		h.draftsman = obj
		h.direction = vector():set(0, -1, 0)
		obj:hit(h)
	end)
	applying = false
	dbg("broke " .. a[2])
end)

------------------------------------------------------------------ traders
local function slotted(npc)
	local keep = {}
	for slot = 0, 13 do
		local o = npc:item_in_slot(slot)
		if o then keep[o:id()] = true end
	end
	local w = npc:active_item()
	if w then keep[w:id()] = true end
	return keep
end

local function goods(npc)
	local keep, list = slotted(npc), {}
	npc:iterate_inventory(function(_, o)
		if o and not keep[o:id()] then
			local cond = o.condition and o:condition() or 1
			local ammo = (IsAmmo(o) and o:ammo_get_count()) or 0
			list[#list+1] = string.format("%s:%.3f:%d", o:section(), cond, ammo)
		end
	end, nil)
	return list
end

local function give(npc, sec, cond, ammo)
	if not ini_sys:section_exist(sec) then return end
	local t = {}
	cond, ammo = tonumber(cond), tonumber(ammo)
	if cond and cond < 0.999 then t.cond = cond end
	if ammo and ammo > 0 then t.ammo = ammo end
	alife_create_item(sec, npc, t)
end

local function npc_on_use(npc, who)
	if not (npc and who and who:id() == AC_ID) then return end
	talking_to = npc:id()
	if coop_main.connected and guest() and IsStalker(npc) then
		coop_main.send("treq", R(npc:id()), npc:section())
	end
end

local function actor_on_trade(item, sell_bye, money)
	if applying or not (coop_main.connected and item and talking_to) then return end
	local parent = item:parent()
	if parent and parent:id() == AC_ID then
		coop_main.send("tbuy", R(talking_to), item:section())
	else
		local cond = item.condition and item:condition() or 1
		local ammo = (IsAmmo(item) and item:ammo_get_count()) or 0
		coop_main.send("tsell", R(talking_to), item:section(), string.format("%.3f", cond), ammo)
	end
end

coop_main.on_event("tbuy", function(a)
	local npc = level.object_by_id(L(a[1]) or -1)
	if not npc then return end
	local keep, found = slotted(npc), nil
	npc:iterate_inventory(function(_, o) if not found and o and o:section() == a[2] and not keep[o:id()] then found = o end end, nil)
	if found then
		applying = true
		local se = alife_object(found:id())
		if se then alife_release(se) end
		applying = false
		dbg("trader sold " .. a[2] .. " to partner")
	end
end)

coop_main.on_event("tsell", function(a)
	local npc = level.object_by_id(L(a[1]) or -1)
	if not npc then return end
	applying = true
	pcall(give, npc, a[2], a[3], a[4])
	applying = false
	dbg("trader bought " .. a[2] .. " from partner")
end)

coop_main.on_event("treq", function(a)
	if not host() then return end
	local npc = level.object_by_id(L(a[1]) or -1)
	if not (npc and npc:section() == a[2] and npc:alive()) then return end
	coop_main.send("tstock", a[1], a[2], npc:money(), table.concat(goods(npc), ";"))
end)

coop_main.on_event("tstock", function(a)
	if host() then return end
	local npc = level.object_by_id(L(a[1]) or -1)
	if not (npc and npc:section() == a[2] and npc:alive()) then return end
	applying = true
	local ok, err = pcall(function()
		local keep, old = slotted(npc), {}
		npc:iterate_inventory(function(_, o) if o and not keep[o:id()] then old[#old+1] = o:id() end end, nil)
		for _, id in ipairs(old) do
			local se = alife_object(id)
			if se then alife_release(se) end
		end
		local n = 0
		for entry in (a[4] or ""):gmatch("[^;]+") do
			local sec, cond, ammo = entry:match("^([^:]+):([^:]*):(%d*)$")
			if sec then give(npc, sec, cond, ammo); n = n + 1 end
		end
		local money = tonumber(a[3])
		if money and npc.give_money then npc:give_money(money - npc:money()) end
		dbg(string.format("trader %s: %d goods from host (replaced %d)", npc:section(), n, #old))
	end)
	applying = false
	if not ok then coop_main.log("tstock failed: " .. tostring(err)) end
end)

-- the guest's traders restock only from the host
local function hook_trade_restock()
	if not (trade_manager and trade_manager.update) or rawget(_G, "coop_trade_hooked") then return end
	_G.coop_trade_hooked = true
	local update = trade_manager.update
	trade_manager.update = function(npc, force_refresh)
		if guest() then return end
		return update(npc, force_refresh)
	end
end

------------------------------------------------------------------ reward stashes (treasure_manager)
-- Contents are spawned lazily when the stash is first opened. Whoever opens it first spawns them;
-- the other side spawns the same list once, so neither gets them twice.
local opened_here = {}       -- local box id -> true when the contents were spawned on this side

local function spawn_stash_contents(box_id)
	local tm = treasure_manager
	local content = tm and tm.caches and tm.caches[box_id]
	if type(content) ~= "string" then return 0 end
	tm.caches[box_id] = true
	local se_box = alife_object(box_id)
	if not se_box then return 0 end
	local n = 0
	for sec in content:gmatch("[^,]+") do
		if ini_sys:section_exist(sec) then alife_create_item(sec, se_box); n = n + 1 end
	end
	return n
end

local function hook_treasures()
	local tm = treasure_manager
	if not (tm and tm.set_random_stash and tm.try_spawn_treasure) or rawget(_G, "coop_treasure_hooked") then return end
	_G.coop_treasure_hooked = true
	local set = tm.set_random_stash
	tm.set_random_stash = function(no_spot, hint, bonus_items, id, dbg_flag)
		local res = set(no_spot, hint, bonus_items, id, dbg_flag)
		pcall(function()
			if host() and coop_main.connected and id and type(tm.caches[id]) == "string" then
				coop_main.send("tmark", R(id), (no_spot ~= true) and 1 or 0, hint or "", tm.caches[id])
			end
		end)
		return res
	end
	local try = tm.try_spawn_treasure
	tm.try_spawn_treasure = function(box)
		local id = box and box:id()
		local fresh = id and type(tm.caches[id]) == "string"
		local res = try(box)
		if fresh and not applying then
			opened_here[id] = true
			-- the guest opened it first: the host spawns the same list (and that comes back as "bspawn", skipped)
			if coop_main.connected and guest() then pcall(coop_main.send, "tspawn", R(id)) end
		end
		return res
	end
end

coop_main.on_event("tmark", function(a)
	if host() then return end
	local id = L(a[1])
	if not (id and alife_object(id) and treasure_manager) then return end
	treasure_manager.caches[id] = a[4]
	if a[2] == "1" and level.map_has_object_spot(id, "treasure") == 0 then
		level.map_add_object_spot_ser(id, "treasure", a[3] or "")
	end
	dbg("stash marked " .. id)
end)

coop_main.on_event("tspawn", function(a)
	local id = L(a[1])
	if not id or opened_here[id] then return end
	applying = true
	local ok, n = pcall(spawn_stash_contents, id)
	applying = false
	dbg("stash " .. id .. " opened by partner: spawned " .. tostring(n))
end)

-- the host's lazy spawn shows up at the guest as "bspawn": skip it when the guest already opened the stash
function stash_spawned_here(box_id) return opened_here[box_id] == true end

------------------------------------------------------------------ player-made stashes (backpacks)
local function actor_on_stash_create(data)
	if applying or not (coop_main.connected and data and data.stash_id) then return end
	local se = alife_object(data.stash_id)
	if not se then return end
	local p = se.position
	coop_main.send("pstash", data.stash_id, data.stash_name or "", string.format("%.2f", p.x), string.format("%.2f", p.y),
		string.format("%.2f", p.z), se.m_level_vertex_id, se.m_game_vertex_id, data.stash_section or "")
end

coop_main.on_event("pstash", function(a)
	local remote_id = tonumber(a[1])
	if not remote_id then return end
	applying = true
	local se = alife_create("inv_backpack", vector():set(tonumber(a[3]) or 0, tonumber(a[4]) or 0, tonumber(a[5]) or 0), tonumber(a[6]), tonumber(a[7]))
	applying = false
	if not se then return end
	level.map_add_object_spot_ser(se.id, "treasure", a[2] or "")
	local m_data = alife_storage_manager.get_state()
	m_data.player_created_stashes = m_data.player_created_stashes or {}
	m_data.player_created_stashes[se.id] = a[8] ~= "" and a[8] or "itm_backpack"
	if host() then
		-- the guest's box has a guest id: tell the guest which host id it maps to
		coop_main.send("pstash_map", remote_id, se.id)
	else
		coop_spawn.map_pair(remote_id, se.id)
	end
	dbg("partner stash created " .. se.id)
end)

coop_main.on_event("pstash_map", function(a)
	if host() then return end
	coop_spawn.map_pair(a[2], a[1]) -- host id, guest id
end)

------------------------------------------------------------------ surrender
local surrender_sent = {}

local function check_surrender()
	for id, st in pairs(db.storage) do
		if st.victim_surrender == AC_ID and not surrender_sent[id] and st.object and st.object:alive() then
			surrender_sent[id] = true
			coop_main.send("surr", R(id), st.object:section())
		end
	end
end

coop_main.on_event("surr", function(a)
	local id = L(a[1])
	local st = id and db.storage[id]
	if st and st.object and st.object:section() == a[2] and st.object:alive() then
		st.victim_surrender = AC_ID -- surrender to whoever is on this side; the partner's puppet cannot hold it
		surrender_sent[id] = true
		dbg("surrendered " .. a[2])
	end
end)

------------------------------------------------------------------ push doors (physics hinges, no script)
local DOOR_RADIUS = 30
local door_reported = {}     -- id -> angle last sent or applied
local door_target = {}       -- id -> angle the partner moved it to
local next_door_scan = 0

local function door_joint(obj)
	if not obj or (db.storage[obj:id()] and db.storage[obj:id()].ph_door) then return end -- scripted doors use "door"
	local ok, j = pcall(function()
		local sh = obj:get_physics_shell()
		return sh and sh:get_joint_by_bone_name("door")
	end)
	return ok and j or nil
end

local function each_push_door(fn)
	local seen = {}
	local centers = { db.actor:position() }
	local r = coop_player.get_remote()
	if r and r.level == level.name() then centers[#centers+1] = r.pos end
	for _, c in ipairs(centers) do
		level.iterate_nearest(c, DOOR_RADIUS, function(obj)
			if obj and not seen[obj:id()] then
				seen[obj:id()] = true
				local j = door_joint(obj)
				if j then fn(obj, j) end
			end
		end)
	end
end

coop_main.add_state_provider("pd", function()
	if not coop_main.connected then return end
	local now = time_global()
	if now < next_door_scan then return end
	next_door_scan = now + 300
	local list = { tostring(now) }
	each_push_door(function(obj, j)
		local id = obj:id()
		if door_target[id] then return end -- being driven by the partner
		local ang = j:get_axis_angle(0)
		if not door_reported[id] then door_reported[id] = ang return end
		if math.abs(ang - door_reported[id]) > 0.08 then
			door_reported[id] = ang
			list[#list+1] = string.format("%d:%.3f", R(id), ang)
		end
	end)
	return list
end)

local last_pd = nil
coop_main.on_state("pd", function(t)
	if t[1] == last_pd then return end
	last_pd = t[1]
	for i = 2, #t do
		local id, ang = t[i]:match("^(%d+):([%-%d%.]+)$")
		id, ang = L(id), tonumber(ang)
		if id and ang then door_target[id] = ang end
	end
end)

-- drive doors toward the partner's angle, then let go so players can push them again
local function drive_doors()
	for id, target in pairs(door_target) do
		local obj = level.object_by_id(id)
		local j = door_joint(obj)
		if not j then
			door_target[id] = nil
		else
			local diff = target - j:get_axis_angle(0)
			if math.abs(diff) < 0.04 then
				j:set_max_force_and_velocity(0, 0, 0)
				door_reported[id] = target
				door_target[id] = nil
			else
				j:set_max_force_and_velocity(2000, math.max(-3, math.min(3, diff * 6)), 0)
			end
		end
	end
end

local next_tick = 0
local function actor_on_update()
	local now = time_global()
	if now < next_tick then return end
	next_tick = now + 100
	local ok, err = pcall(function()
		drive_doors()
		if coop_main.connected and now % 1000 < 100 then check_surrender() end
	end)
	if not ok then coop_main.log("objects update failed: " .. tostring(err)) end
end

function is_applying() return applying end

function on_game_start()
	hook_doors()
	hook_breakables()
	hook_trade_restock()
	hook_treasures()
	opened_here, surrender_sent, door_reported, door_target = {}, {}, {}, {}
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_stash_create", actor_on_stash_create)
	ready_at = nil
	RegisterScriptCallback("actor_on_first_update", function() ready_at = time_global() + 8000 end)
	RegisterScriptCallback("npc_on_use", npc_on_use)
	RegisterScriptCallback("actor_on_trade", actor_on_trade)
end
