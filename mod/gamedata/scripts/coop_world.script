--[[
	Anomaly Co-op: world sync.
	Both players start from the host's save, so object ids match and events are matched by id + section.
	  host -> client: game time, weather, surge (state "w"), creature positions/health (state "n")
	  host -> client: corpse inventories after death ("loot"), hostility in the creature state
	  both ways:      damage dealt by the actor ("hit"), deaths ("die"),
	                  items taken from the ground ("take") or from boxes/corpses ("btake"),
	                  items dropped ("drop") or put into boxes ("bput")
--]]

local NPC_SYNC_RADIUS = 150 -- as far as creatures come online: closer, the guest's own AI would have them elsewhere
local NPC_SNAP_DIST = 3      -- standing and out of sight
local NPC_SNAP_MOVING = 10   -- running: the host's position is already behind
local NPC_SNAP_SEEN = 15     -- in the guest's view: a jump is worse than a small difference
local npc_last_pos = {}      -- host id -> position from the previous update
local NPC_SEND_MS = 200      -- host: creature positions 5 times per second
-- co-op engine r2+: on the guest the engine places the host's creatures every frame between these updates
-- (their own AI still aims, shoots and talks); with stock exes they are put back only when far off
local ENGINE = rawget(_G, "coop_engine_version") and coop_engine_version() or 0
local NPC_PUPPET_HOLD = 6500 -- ms without an update before a creature goes back to the guest's own AI
local npc_puppets = {}       -- local id -> time of the last update
local npc_crouched = {}      -- host: ids of the stalkers in the last "n" that crouch (sent as "nb")
local npc_mental = {}        -- host: "id:state" of the stalkers in the last "n" (sent as "nm"), state as in anim.danger/free/panic

local applying = false         -- true while we apply a remote event, to avoid echoing it back
function is_applying() return applying end
local pending_hits = {}        -- id -> health before the actor's hit
local pending_take = {}        -- id -> { sec, pos }
local pending_drop = {}        -- id -> sec
local box_take = {}            -- item id -> box id (filled by actor_on_item_take_from_box)

local function puppet_obj()
	local id = coop_player.get_puppet_id()
	return id and level.object_by_id(id)
end

local function same(obj, sec)
	return obj and obj:section() == sec
end

local function vec(x, y, z) return vector():set(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0) end
local function f2(n) return string.format("%.2f", n) end
local function dbg(s) if coop_main.debug then coop_main.log(s) end end

local function is_creature(obj)
	return obj and (IsStalker(obj) or IsMonster(obj))
end

------------------------------------------------------------------ time, weather, surge (host authority)
local function game_minutes()
	return (level.get_time_days() * 24 + level.get_time_hours()) * 60 + level.get_time_minutes()
end

coop_main.add_state_provider("w", function()
	if not coop_main.is_host() then return end
	return { game_minutes(), level.get_weather() or "", surge_manager.is_started() and 1 or 0 }
end)

local next_world_apply = 0
coop_main.on_state("w", function(t)
	if not coop_main.is_client() then return end
	local now = time_global()
	if now < next_world_apply then return end
	next_world_apply = now + 2000

	local diff = (tonumber(t[1]) or 0) - game_minutes()
	if diff > 2 then
		-- only forward: the engine cannot rewind time
		level.change_game_time(0, math.floor(diff / 60), diff % 60)
	end
	local w = t[2]
	if w and w ~= "" and level.get_weather() ~= w then
		level.set_weather(w, false)
	end
	local host_surge = t[3] == "1"
	if host_surge and not surge_manager.is_started() then
		coop_main.msg("У хоста начался выброс!")
		surge_manager.start_surge()
	elseif (not host_surge) and surge_manager.is_started() then
		surge_manager.stop_surge()
	end
end)

------------------------------------------------------------------ creature positions (host authority)
local next_npc_send = 0
local npc_sent, npc_full_at = {}, 0
coop_main.add_state_provider("n", function()
	if not coop_main.is_host() then return end
	local now = time_global()
	if now < next_npc_send then return end -- nil = keep the last value on the bridge
	next_npc_send = now + NPC_SEND_MS
	local remote = coop_player.get_remote()
	local apos = db.actor:position()
	local rpos = remote and remote.level == level.name() and remote.pos
	-- deltas: only creatures that moved or got hurt since the last send, everything every 5 s
	if now > npc_full_at then
		npc_full_at = now + 5000
		npc_sent = {}
	end
	local list = { tostring(now) }
	local crouched, mental = {}, {}
	for id, st in pairs(db.storage) do
		local obj = st.object
		if obj and id ~= AC_ID and not coop_player.is_puppet(id) and is_creature(obj) and obj:alive() then
			local p = obj:position()
			if p:distance_to(apos) < NPC_SYNC_RADIUS or (rpos and p:distance_to(rpos) < NPC_SYNC_RADIUS) then
				if IsStalker(obj) then
					if obj:body_state() == move.crouch then crouched[#crouched+1] = tostring(id) end
					local m = tonumber(obj:mental_state())
					-- and whether its weapon is on its back (r11): the guest's AI would ready it at its own sounds
					local strapped = obj:weapon_strapped() and 1 or 0
					if m then mental[#mental+1] = id .. ":" .. m .. ":" .. strapped end
				end
				local last = npc_sent[id]
				local rel_now = IsStalker(obj) and obj:relation(db.actor) or 2
				if not last or last.pos:distance_to(p) > 0.1 or math.abs(last.h - obj.health) > 0.02 or last.rel ~= rel_now then
					npc_sent[id] = { pos = vector():set(p), h = obj.health, rel = rel_now }
					local rel = IsStalker(obj) and obj:relation(db.actor) or 2
					list[#list+1] = string.format("%d:%s:%.2f:%.2f:%.2f:%.2f:%d", id, obj:section(), p.x, p.y, p.z, obj.health, rel)
				end
			end
		end
	end
	npc_crouched = crouched
	npc_mental = mental
	return list
end)

-- which of the host's stalkers crouch: a separate state, so older guests that do not know it still read "n"
coop_main.add_state_provider("nb", function()
	if not coop_main.is_host() then return end
	return { table.concat(npc_crouched, ",") }
end)

coop_main.on_state("nb", function(t)
	if ENGINE < 3 or not coop_main.is_client() then return end
	local crouch = {}
	for hid in (t[1] or ""):gmatch("%d+") do
		local id = coop_spawn.L(hid)
		if id then crouch[id] = true end
	end
	for id in pairs(npc_puppets) do
		local obj = level.object_by_id(id)
		if obj and IsStalker(obj) then obj:net_puppet_body(crouch[id] and 0 or 1) end
	end
end)

-- how calm the host's stalkers are and where their weapons are: the guest's own AI would show them alert at
-- whatever it hears (r7, the weapon r11)
coop_main.add_state_provider("nm", function()
	if not coop_main.is_host() then return end
	return { table.concat(npc_mental, ",") }
end)

coop_main.on_state("nm", function(t)
	if ENGINE < 7 or not coop_main.is_client() then return end
	local mental, strap = {}, {}
	for entry in (t[1] or ""):gmatch("[^,]+") do
		local hid, m, s = entry:match("^(%d+):(%d+):?(%d?)$")
		local id = hid and coop_spawn.L(hid)
		if id then
			mental[id] = tonumber(m)
			strap[id] = tonumber(s)
		end
	end
	for id in pairs(npc_puppets) do
		local obj = level.object_by_id(id)
		if obj and IsStalker(obj) then
			obj:net_puppet_mental(mental[id] or 255)
			if ENGINE >= 11 then obj:net_puppet_strap(strap[id] or 255) end
		end
	end
end)

local last_npc_stamp = nil
coop_main.on_state("n", function(t)
	if not coop_main.is_client() or t[1] == last_npc_stamp then return end
	last_npc_stamp = t[1]
	local stamp = tonumber(t[1])
	local now = time_global()
	applying = true
	for i = 2, #t do
		local id, sec, x, y, z, h, rel = t[i]:match("^(%d+):([^:]+):([^:]+):([^:]+):([^:]+):([^:]+):?(%d?)$")
		id = coop_spawn.L(id)
		local obj = id and level.object_by_id(id)
		if same(obj, sec) and obj:alive() then
			local pos = vec(x, y, z)
			if ENGINE >= 2 and stamp then
				if not npc_puppets[id] then obj:net_puppet(true, 0) end
				npc_puppets[id] = now
				obj:net_puppet_push(pos, stamp)
			else
				-- the host's positions are a moment old plus the ping: a running NPC is always a few metres off.
				-- Put it back only where it does not show, or when it went really far.
				local off = obj:position():distance_to(pos)
				local last = npc_last_pos[id]
				local running = last and last:distance_to(pos) > 1.5
				npc_last_pos[id] = pos
				local seen = db.actor and db.actor:see(obj) and obj:position():distance_to(db.actor:position()) < 60
				local limit = seen and NPC_SNAP_SEEN or (running and NPC_SNAP_MOVING or NPC_SNAP_DIST)
				if off > limit then
					obj:set_npc_position(pos)
				end
			end
			h = tonumber(h)
			if h and h < obj.health - 0.05 then obj:set_health_ex(h) end
			-- whoever the NPC is hostile to on the host side, it is hostile to the whole team
			if rel == "2" and IsStalker(obj) and obj:relation(db.actor) ~= game_object.enemy then
				obj:set_relation(game_object.enemy, db.actor)
			end
		end
	end
	applying = false
	-- out of the host's reach for a while (far away, gone): back to the guest's own AI
	for id, at in pairs(npc_puppets) do
		if now - at > NPC_PUPPET_HOLD then release_npc_puppet(id) end
	end
end)

function release_npc_puppet(id)
	local obj = level.object_by_id(id)
	if obj and obj.net_puppet then obj:net_puppet(false, 0) end
	npc_puppets[id] = nil
end

-- the partner left: every creature goes back to the guest's own AI
coop_main.on_event("_connection", function(a)
	if a[1] ~= "1" then
		for id in pairs(npc_puppets) do release_npc_puppet(id) end
	end
end)

------------------------------------------------------------------ damage
local function on_before_hit(obj, shit)
	if applying or coop_player.is_puppet(obj) then return end
	if shit.draftsman and shit.draftsman:id() == AC_ID and obj:alive() then
		if not pending_hits[obj:id()] then pending_hits[obj:id()] = obj.health end
	end
end

local function flush_hits()
	for id, before in pairs(pending_hits) do
		local obj = level.object_by_id(id)
		if obj then
			local delta = before - (obj:alive() and obj.health or 0)
			if delta > 0.001 then coop_main.send("hit", coop_spawn.R(id), obj:section(), string.format("%.3f", delta)) end
		end
	end
	pending_hits = {}
end

coop_main.on_event("hit", function(a)
	local id = coop_spawn.L(a[1])
	local obj = id and level.object_by_id(id)
	dbg("recv hit " .. tostring(a[1]) .. " " .. tostring(a[2]) .. " match=" .. tostring(same(obj, a[2])))
	if not (same(obj, a[2]) and obj:alive()) then return end
	local h = obj.health - (tonumber(a[3]) or 0)
	if IsStalker(obj) and obj:relation(db.actor) ~= game_object.enemy and not coop_player.is_puppet(obj) then
		obj:set_relation(game_object.enemy, db.actor)
	end
	applying = true
	if h <= 0.005 then
		obj:kill(puppet_obj() or obj)
	else
		obj:set_health_ex(h)
	end
	applying = false
end)

------------------------------------------------------------------ deaths
local pending_loot = {}      -- host: corpse id -> time to send its inventory (after death_manager filled it)
local pending_corpse = {}    -- host: corpse id -> time to send where the body came to rest
local refresh = {}           -- { box, at }: show the open box again once the partner's item is in it
-- (twice: the item comes a few frames after the word, sometimes later)
local function want_refresh(id)
	local now = time_global()
	refresh[#refresh + 1] = { id, now + 400 }
	refresh[#refresh + 1] = { id, now + 1500 }
end
local pending_corpse2 = {}   -- host: the same once more, for a body still sliding at the first

-- A box holds what the host's box holds: after every change there the host sends the whole list ("bset") and
-- the guest's box is made the same. The guest's own changes go to the host first, numbered: a list that does
-- not have the guest's last change yet is not applied (the next one will have it).
local box_seq = 0            -- guest: its last change to a box sent to the host
local box_acked = 0          -- host: the guest's last change applied here
local snap_at = {}           -- host: box id -> when to send what it holds
local function want_snapshot(id)
	if id and coop_main.is_host() then snap_at[id] = time_global() + 300 end
end
local function next_box_seq()
	if coop_main.is_host() then return 0 end
	box_seq = box_seq + 1
	return box_seq
end

local function on_death(victim, who)
	-- a dead body falls by itself: the host's moves no longer drive it
	if victim and npc_puppets[victim:id()] then release_npc_puppet(victim:id()) end
	if victim and coop_main.is_host() and coop_main.connected and is_creature(victim) and not coop_player.is_puppet(victim) then
		pending_loot[victim:id()] = time_global() + 3000
		pending_corpse[victim:id()] = time_global() + 3000
		pending_corpse2[victim:id()] = time_global() + 12000
	end
	if applying or not coop_main.connected or not victim then return end
	if coop_player.is_puppet(victim) or victim:id() == AC_ID then return end
	-- the host reports every death it sees, the client only kills made by the actor
	if coop_main.is_host() or (who and who:id() == AC_ID) then
		coop_main.send("die", coop_spawn.R(victim:id()), victim:section())
	end
end

coop_main.on_event("die", function(a)
	local id = coop_spawn.L(a[1])
	local obj = id and level.object_by_id(id)
	dbg("recv die " .. tostring(a[1]) .. " " .. tostring(a[2]) .. " match=" .. tostring(same(obj, a[2])))
	if same(obj, a[2]) and obj:alive() then
		applying = true
		obj:kill(puppet_obj() or obj)
		applying = false
	elseif not obj then
		-- offline: mark the server object dead so it does not come online alive
		local se = id and alife_object(id)
		if se and se:section_name() == a[2] and se.kill and se:alive() then se:kill() end
	end
end)

------------------------------------------------------------------ items
local suppress_until = 0
-- ignore our own inventory changes for a while (character import)
function suppress(ms) suppress_until = time_global() + ms end
local function suppressed() return applying or time_global() < suppress_until end

local function actor_on_item_take(item)
	if suppressed() or not coop_main.connected then return end
	pending_take[item:id()] = { item:section(), vector():set(db.actor:position()) }
end

local function actor_on_item_take_from_box(box, item)
	if suppressed() or not coop_main.connected or not box or not item then return end
	box_take[item:id()] = box:id()
end

local function actor_on_item_drop(item)
	if suppressed() or not coop_main.connected then return end
	pending_drop[item:id()] = item:section()
end

local function item_props(obj)
	local cond = obj.condition and obj:condition() or 1
	local ammo = (IsAmmo and IsAmmo(obj) and obj:ammo_get_count()) or 0
	return string.format("%.3f", cond), ammo
end

local function flush_loot()
	local now = time_global()
	for id, at in pairs(pending_loot) do
		if now >= at then
			pending_loot[id] = nil
			local npc = level.object_by_id(id)
			if npc and not npc:alive() and IsStalker(npc) then
				local list = {}
				npc:iterate_inventory(function(_, o)
					if o and o:section() then
						local cond, ammo = item_props(o)
						list[#list+1] = string.format("%s:%s:%s", o:section(), cond, ammo)
					end
				end, nil)
				coop_main.send("loot", coop_spawn.R(id), npc:section(), table.concat(list, ";"))
			end
		end
	end
	-- a body falls its own way in each game: the guest's is put where the host's came to rest
	for id, at in pairs(pending_corpse2) do
		if now >= at then
			pending_corpse2[id] = nil
			pending_corpse[id] = now
		end
	end
	for id, at in pairs(pending_corpse) do
		if now >= at then
			pending_corpse[id] = nil
			local npc = level.object_by_id(id)
			if npc and not npc:alive() then
				local p = npc:position()
				coop_main.send("corpse", coop_spawn.R(id), npc:section(), f2(p.x), f2(p.y), f2(p.z))
			end
		end
	end
end

coop_main.on_event("corpse", function(a)
	if coop_main.is_host() then return end
	local npc = level.object_by_id(coop_spawn.L(a[1]) or -1)
	if not (same(npc, a[2]) and not npc:alive() and npc.force_set_position) then
		dbg(string.format("corpse %s %s: %s", tostring(a[1]), tostring(a[2]),
			not npc and "not here" or (npc:alive() and "alive here" or "other section")))
		return
	end
	-- a creature the host's moves were still driving here
	release_npc_puppet(npc:id())
	local pos = vec(a[3], a[4], a[5])
	local off = npc:position():distance_to(pos)
	if off > 1 then
		npc:force_set_position(pos, false)
	end
	dbg(string.format("corpse %s: %.1f m off the host's", npc:section(), off))
end)

local function flush_items()
	for id, t in pairs(pending_take) do
		local box = box_take[id]
		if box and coop_trade.is_exchange_box(box) then
			-- taken back from the exchange box: not a world event
		elseif box then
			coop_main.send("btake", coop_spawn.R(box), coop_spawn.R(id), t[1], next_box_seq())
			want_snapshot(box)
		else
			coop_main.send("take", coop_spawn.R(id), t[1], f2(t[2].x), f2(t[2].y), f2(t[2].z))
		end
	end
	pending_take, box_take = {}, {}

	for id, sec in pairs(pending_drop) do
		local obj = level.object_by_id(id)
		if obj then -- gone = eaten/used/sold to nothing
			local parent = obj:parent()
			local cond, ammo = item_props(obj)
			if not parent then
				local p = obj:position()
				coop_main.send("drop", id, sec, cond, ammo, f2(p.x), f2(p.y), f2(p.z), obj:level_vertex_id(), obj:game_vertex_id())
			elseif parent:id() ~= AC_ID and IsInvbox(parent) and not coop_trade.is_exchange_box(parent:id()) then
				coop_main.send("bput", coop_spawn.R(parent:id()), sec, cond, ammo, next_box_seq())
				want_snapshot(parent:id())
			end
		end
	end
	pending_drop = {}
end

-- find a ground item by id, else the nearest one of the same section
local function find_ground_item(id, sec, pos, radius)
	local obj = id and level.object_by_id(id)
	if same(obj, sec) and not obj:parent() then return obj end
	local best, bd = nil, radius
	for oid, st in pairs(db.storage) do
		local o = st.object
		if o and o:section() == sec and not o:parent() then
			local d = o:position():distance_to(pos)
			if d < bd then best, bd = o, d end
		end
	end
	if best then return best end
	-- items do not always live in db.storage; scan nearby objects
	level.iterate_nearest(pos, radius, function(o)
		if o and o:section() == sec and not o:parent() then best = o return true end
	end)
	return best
end

local function release_obj(obj)
	local se = obj and alife_object(obj:id())
	if se then alife_release(se) end
end

coop_main.on_event("take", function(a)
	local obj = find_ground_item(coop_spawn.L(a[1]), a[2], vec(a[3], a[4], a[5]), 4)
	dbg("recv take " .. tostring(a[2]) .. " found=" .. tostring(obj ~= nil))
	if obj then
		applying = true
		release_obj(obj)
		applying = false
	end
end)

-- a box or body open here shows what the partner just took or put (r11)
local function refresh_open_box(box)
	if not box or ENGINE < 11 then return true end
	local menu = ActorMenu and ActorMenu.get_actor_menu and ActorMenu.get_actor_menu()
	if not (menu and menu.coop_refresh_box) then return true end
	local ok, done = pcall(menu.coop_refresh_box, menu, box:id())
	-- (false: the player is dragging an item just now)
	return not ok or done ~= false
end

-- the host's state of what the guest took from a box or a body
coop_main.on_event("bcond", function(a)
	local item = level.object_by_id(coop_spawn.L(a[1]) or -1)
	local cond = tonumber(a[3])
	if not (same(item, a[2]) and cond and item:parent() and item:parent():id() == AC_ID and item.set_condition) then return end
	if math.abs((item:condition() or 1) - cond) > 0.001 then
		pcall(item.set_condition, item, cond)
		dbg(string.format("took %s: condition %.2f as the host's", a[2], cond))
	end
end)

-- both took the same thing at once: it stays with the host, the guest gives its copy up
coop_main.on_event("bdeny", function(a)
	local id, sec = coop_spawn.L(a[1]), a[2]
	local item = id and level.object_by_id(id)
	if same(item, sec) and item:parent() and item:parent():id() == AC_ID then
		applying = true
		release_obj(item)
		applying = false
		coop_main.msg(string.format("%s забрал это раньше вас", coop_main.peer_name))
	end
end)

coop_main.on_event("btake", function(a)
	local box = level.object_by_id(coop_spawn.L(a[1]) or -1)
	local id, sec = coop_spawn.L(a[2]), a[3]
	local item = id and level.object_by_id(id)
	if coop_main.is_host() then
		box_acked = math.max(box_acked, tonumber(a[4]) or 0)
		want_snapshot(box and box:id())
	end
	-- this player took the same item a moment before the word came
	if same(item, sec) and item:parent() and item:parent():id() == AC_ID then
		if coop_main.is_host() then
			coop_main.send("bdeny", a[2], sec)
		else
			applying = true
			release_obj(item)
			applying = false
			coop_main.msg(string.format("%s забрал это раньше вас", coop_main.peer_name))
		end
		return
	end
	if not (same(item, sec) and item:parent() and box and item:parent():id() == box:id()) then
		item = nil
		if box then
			box:iterate_inventory_box(function(b, o)
				if not item and o:section() == sec then item = o end
			end, box)
			if not item and box.iterate_inventory then
				box:iterate_inventory(function(b, o)
					if not item and o:section() == sec then item = o end
				end, box)
			end
		end
	end
	if item then
		-- the guest's copy may be in another state (a body's loot is rolled in each game): it takes the host's
		if coop_main.is_host() then
			local cond = item_props(item)
			coop_main.send("bcond", a[2], sec, cond)
		end
		applying = true
		release_obj(item)
		applying = false
		-- the item goes a few frames later
		want_refresh(box and box:id() or item:id())
	elseif box and coop_main.is_host() then
		-- the guest took what is no longer there (the host had it a moment before): the guest gives it up
		coop_main.send("bdeny", a[2], sec)
	end
end)

local function spawn_item(sec, owner, cond, ammo)
	if not ini_sys:section_exist(sec) then return end
	local t = {}
	cond = tonumber(cond)
	ammo = tonumber(ammo)
	if cond and cond < 0.999 then t.cond = cond end
	if ammo and ammo > 0 then t.ammo = ammo end
	applying = true
	alife_create_item(sec, owner, t)
	applying = false
end

-- guest: replace what the local death_manager put on the body with the host's list
coop_main.on_event("loot", function(a)
	if coop_main.is_host() then return end
	local npc = level.object_by_id(coop_spawn.L(a[1]) or -1)
	if not (same(npc, a[2]) and not npc:alive()) then return end
	applying = true
	local old = {}
	npc:iterate_inventory(function(_, o) if o then old[#old+1] = o:id() end end, nil)
	for _, id in ipairs(old) do
		local se = alife_object(id)
		if se then alife_release(se) end
	end
	local n = 0
	for entry in (a[3] or ""):gmatch("[^;]+") do
		local sec, cond, ammo = entry:match("^([^:]+):([^:]*):(%d*)$")
		if sec and ini_sys:section_exist(sec) then
			spawn_item(sec, npc, cond, ammo)
			n = n + 1
		end
	end
	applying = false
	want_refresh(npc:id())
	if coop_main.debug then coop_main.log("loot " .. npc:section() .. ": " .. n .. " items from host, replaced " .. #old) end
end)

coop_main.on_event("drop", function(a)
	-- a: id, sec, cond, ammo, x, y, z, lvid, gvid
	if coop_player.get_remote() and coop_player.get_remote().level ~= level.name() then return end
	local pos = vec(a[5], a[6], a[7])
	local lvid = tonumber(a[8]) or level.vertex_id(pos)
	if lvid >= 4294967295 then lvid = level.vertex_id(pos) end
	spawn_item(a[2], { pos, lvid, tonumber(a[9]) or db.actor:game_vertex_id() }, a[3], a[4])
	dbg("recv drop " .. tostring(a[2]) .. " at " .. vec_to_str(pos))
end)

coop_main.on_event("bput", function(a)
	local box = level.object_by_id(coop_spawn.L(a[1]) or -1)
	if coop_main.is_host() then
		box_acked = math.max(box_acked, tonumber(a[5]) or 0)
		want_snapshot(box and box:id())
	end
	if box then
		spawn_item(a[2], box, a[3], a[4])
		-- the new item comes into the box a moment later
		want_refresh(box:id())
	end
end)

local function box_items(box)
	local list = {}
	box:iterate_inventory_box(function(_, o) list[#list + 1] = o end, box)
	return list
end

local function flush_snapshots(now)
	for id, at in pairs(snap_at) do
		if now >= at then
			snap_at[id] = nil
			local box = level.object_by_id(id)
			if box and IsInvbox(box) and not coop_trade.is_exchange_box(id) then
				local list = {}
				for _, o in ipairs(box_items(box)) do
					local cond, ammo = item_props(o)
					list[#list + 1] = string.format("%s:%s:%s", o:section(), cond, ammo)
				end
				coop_main.send("bset", coop_spawn.R(id), box_acked, table.concat(list, ";"))
			end
		end
	end
end

coop_main.on_event("bset", function(a)
	if coop_main.is_host() then return end
	-- a change of this player's own is still on its way to the host: the next list has it
	if (tonumber(a[2]) or 0) < box_seq then return end
	local box = level.object_by_id(coop_spawn.L(a[1]) or -1)
	if not (box and IsInvbox(box)) then return end
	local want, have = {}, {}
	for entry in (a[3] or ""):gmatch("[^;]+") do
		local sec, cond, ammo = entry:match("^([^:]+):([^:]*):(%d*)$")
		if sec and ini_sys:section_exist(sec) then
			want[sec] = want[sec] or {}
			want[sec][#want[sec] + 1] = { cond, ammo }
		end
	end
	for _, o in ipairs(box_items(box)) do
		local sec = o:section()
		have[sec] = have[sec] or {}
		have[sec][#have[sec] + 1] = o
	end
	local gone, added = 0, 0
	applying = true
	for sec, list in pairs(have) do
		for i = #(want[sec] or {}) + 1, #list do
			release_obj(list[i])
			gone = gone + 1
		end
	end
	applying = false
	for sec, list in pairs(want) do
		for i = #(have[sec] or {}) + 1, #list do
			spawn_item(sec, box, list[i][1], list[i][2])
			added = added + 1
		end
	end
	if gone + added > 0 then
		want_refresh(box:id())
		dbg(string.format("box %s made as the host's: -%d +%d", box:section(), gone, added))
	end
end)

------------------------------------------------------------------ main loop
local next_flush = 0
local function actor_on_update()
	local now = time_global()
	if now < next_flush then return end
	next_flush = now + 100
	if #refresh > 0 then
		local keep = {}
		for _, r in ipairs(refresh) do
			if now < r[2] then
				keep[#keep + 1] = r
			elseif not refresh_open_box(level.object_by_id(r[1])) then
				keep[#keep + 1] = { r[1], now + 200 }
			end
		end
		refresh = keep
	end
	local ok, err = pcall(function()
		flush_hits()
		flush_items()
		flush_snapshots(now)
		flush_loot()
	end)
	if not ok then coop_main.log("world flush failed: " .. tostring(err)) end
end

local function npc_on_before_hit(npc, shit, bone_id, flags) on_before_hit(npc, shit) end
local function monster_on_before_hit(m, shit, bone_id, flags) on_before_hit(m, shit) end

function on_game_start()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("npc_on_before_hit", npc_on_before_hit)
	RegisterScriptCallback("monster_on_before_hit", monster_on_before_hit)
	RegisterScriptCallback("npc_on_death_callback", on_death)
	RegisterScriptCallback("monster_on_death_callback", on_death)
	RegisterScriptCallback("actor_on_item_take", actor_on_item_take)
	RegisterScriptCallback("actor_on_item_take_from_box", actor_on_item_take_from_box)
	RegisterScriptCallback("actor_on_item_drop", actor_on_item_drop)
end
