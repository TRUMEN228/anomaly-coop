--[[
	dev only: a test both games play together, step by step (active when appdata\coop_scenario.txt exists).
	Before each step a banner in both games says what is about to happen and what to look for, so a person can
	watch along. The host leads: "qa" events tell the guest what to do or to look, "qa_r" brings its answers back.
	Results: "QA <step> PASS|FAIL <detail>" in coop_log.txt and appdata\coop_qa.txt of each game.
	The runner (tests\scenario.ps1) copies this file in, converted to cp1251.
--]]

local active = false
local is_host = false
local ready_at = nil          -- this game's own wait after the first update
local guest_ready = false     -- host: the guest said it is up
local go_sent = false
local started_at = nil        -- host: the scenario's clock
local next_step = 1
local later = {}              -- { at, fn }: things to do a moment later
local ctx = { expect = {} }   -- what the steps share
local banner = { text = "", until_t = 0 }
local PANEL = nil

local CREATURE = "flesh_weak"      -- big and slow: easy to see
local PUT = "kolbasa"         -- not in the sandbox gear: counts start from what the test puts in
local RACE = "energy_drink"

local function app(name) return getFS():update_path("$app_data_root$", name) end

local function record(step, ok, detail)
	local line = string.format("QA %s %s %s", step, ok and "PASS" or "FAIL", detail or "")
	coop_main.log(line)
	local f = io.open(app("coop_qa.txt"), "a")
	if f then f:write(line .. "\n") f:close() end
end

local function after(ms, fn) later[#later + 1] = { time_global() + ms, fn } end

------------------------------------------------------------------ the banner
local function show(text, secs)
	banner.text, banner.until_t = text, time_global() + (secs or 12) * 1000
end

-- on both screens
local function announce(text, secs)
	show(text, secs)
	coop_main.send("qa_show", text, secs or 12)
end

class "UICoopQa" (CUIScriptWnd)

function UICoopQa:__init() super()
	local xml = utils_xml.get_hud_xml()
	self.text = xml:InitTextWnd("companion_list:slot:distance", self)
	local ok, font = pcall(function() return GetFontGraffiti22Russian() end)
	self.text:SetFont(ok and font or GetFontMedium())
	self.text:SetTextComplexMode(true)
	self.text:SetWndPos(vector2():set(112, 30))
	self.text:SetWndSize(vector2():set(800, 180))
	self.text:SetTextAlignment(2)
	self.text:SetVTextAlignment(0)
	self.text:SetTextColor(GetARGB(255, 255, 220, 120))
	self.shown_text = nil
end

function UICoopQa:__finalize() end

function UICoopQa:Update()
	CUIScriptWnd.Update(self)
	local text = time_global() < banner.until_t and banner.text or ""
	if text ~= self.shown_text then
		self.shown_text = text
		self.text:SetText(text)
	end
end

------------------------------------------------------------------ helpers
local function ahead(dist)
	local dir = device().cam_dir
	local p = db.actor:position()
	local pos = vector():set(p.x + dir.x * dist, p.y + 0.5, p.z + dir.z * dist)
	local lv = level.vertex_id(pos)
	if not lv or lv >= 4294967295 then return vector():set(p), db.actor:level_vertex_id() end
	return level.vertex_position(lv), lv
end

local function nearest_box()
	local best, bd = nil, 40
	local here = db.actor:position()
	for id = 1, 65534 do
		local o = level.object_by_id(id)
		if o and IsInvbox(o) and not coop_trade.is_exchange_box(id) then
			local d = o:position():distance_to(here)
			if d < bd then best, bd = o, d end
		end
	end
	return best
end

local function in_box(box, sec)
	local list = {}
	box:iterate_inventory_box(function(_, o) if o:section() == sec then list[#list + 1] = o end end, box)
	return list
end

local function on_actor(sec)
	local list = {}
	db.actor:iterate_inventory(function(_, o) if o:section() == sec then list[#list + 1] = o end end, nil)
	return list
end

-- the player turns to face a point
local function look_at(pos)
	local dir = vector():set(pos):sub(db.actor:position())
	db.actor:set_actor_direction(-dir:getH())
end

-- a point both players see: between them, a few metres aside
local function meeting_point()
	if ctx.spot then
		local lv = level.vertex_id(ctx.spot)
		if lv and lv < 4294967295 then return level.vertex_position(lv), lv end
	end
	local a = db.actor:position()
	local r = coop_player.get_remote()
	local b = r and r.level == level.name() and r.pos or a
	local mid = vector():set((a.x + b.x) / 2, a.y + 0.5, (a.z + b.z) / 2)
	local side = vector():set(b.z - a.z, 0, a.x - b.x)
	if side:magnitude() < 0.5 then side = device().cam_dir end
	side:normalize()
	local pos = vector():set(mid.x + side.x * 6, mid.y, mid.z + side.z * 6)
	local lv = level.vertex_id(pos)
	if not lv or lv >= 4294967295 then return ahead(6) end
	return level.vertex_position(lv), lv
end

local function loot_gui(box)
	local gui = ui_inventory.GUI
	return gui and gui:IsShown() and gui.mode == "loot" and gui.npc_id == box:id() and gui or nil
end

local function open_box(box)
	if not loot_gui(box) then ui_inventory.start("loot", box) end
end

local function close_box()
	local gui = ui_inventory.GUI
	if gui and gui:IsShown() then gui:Close() end
end

-- as a player does it: the loot window open, the item moved, the window read again (which reports the take)
local function take_from(box, sec)
	local item = in_box(box, sec)[1]
	if not item then return false end
	open_box(box)
	box:transfer_item(item, db.actor)
	after(500, function()
		local gui = loot_gui(box)
		if gui then gui:LMode_RefreshInventories() end
	end)
	return true
end

local VILLAGE = "esc_smart_terrain_2_12"
local BOX = "inv_backpack"

-- a spot of open ground: the village's middle, or where the player stands on another level
local function village()
	local smart = SIMBOARD and SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[VILLAGE]
	if smart and level.name() == "l01_escape" then
		return vector():set(smart.position), smart.m_level_vertex_id, smart.m_game_vertex_id
	end
	return vector():set(db.actor:position()), db.actor:level_vertex_id(), db.actor:game_vertex_id()
end

-- a level vertex near pos, dx/dz metres aside
local function aside(pos, dx, dz)
	local p = vector():set(pos.x + dx, pos.y + 0.5, pos.z + dz)
	local lv = level.vertex_id(p)
	if not lv or lv >= 4294967295 then return vector():set(pos), level.vertex_id(pos) end
	return level.vertex_position(lv), lv
end

local function walkable(from, dir, len)
	for d = 1, len, 0.7 do
		local lv = level.vertex_id(vector():set(from.x + dir.x * d, from.y + 0.5, from.z + dir.z * d))
		if not lv or lv >= 4294967295 then return false end
	end
	return true
end

-- the first of eight directions with 9 m of open ground ahead and room for the partner beside
local function open_direction(center)
	for i = 0, 7 do
		local a = i * math.pi / 4
		local dir = vector():set(math.cos(a), 0, math.sin(a))
		local side = vector():set(-dir.z, 0, dir.x)
		if walkable(center, dir, 9) and walkable(center, side, 3) then return dir, side end
	end
	return vector():set(1, 0, 0), vector():set(0, 0, 1)
end

-- a jump on the level is a fast travel to the host's sync: this one is the test's own
local function jump(pos)
	db.actor:set_actor_position(pos)
	if coop_session.alive_write then coop_session.alive_write(true) end
end

local function box_by(id)
	local o = level.object_by_id(coop_spawn.L(id) or -1)
	return o and IsInvbox(o) and o or nil
end

------------------------------------------------------------------ the guest's part
local cmd = {}

cmd.extra = function()
	local pos, lv = ahead(6)
	local se = alife_create(CREATURE, pos, lv, db.actor:game_vertex_id())
	ctx.extra = se and se.id
	return se ~= nil, se and ("made " .. se.id) or "not made"
end

cmd.extra_check = function()
	if not ctx.extra then return false, "never made" end
	local gone = not level.object_by_id(ctx.extra) and not alife_object(ctx.extra)
	return gone, gone and "gone" or "still here"
end

cmd.made_check = function(a)
	local id = coop_spawn.L(a[3])
	local o = id and level.object_by_id(id)
	local ok = o ~= nil and o:section() == a[4]
	return ok, ok and string.format("host %s = guest %d", a[3], id) or "not here"
end

cmd.dead_check = function(a)
	local id = coop_spawn.L(a[3])
	local o = id and level.object_by_id(id)
	if not o then return false, "not here" end
	return not o:alive(), o:alive() and "alive" or "dead"
end

cmd.box_count = function(a)
	local box = box_by(a[3])
	if not box then return false, "no box" end
	return true, tostring(#in_box(box, a[4]))
end

cmd.take = function(a)
	local box = box_by(a[3])
	if not box then return false, "no box" end
	local ok = take_from(box, a[4])
	return ok, ok and "taken" or "none in the box"
end

cmd.has = function(a) return true, tostring(#on_actor(a[3])) end

-- next to the host, and the test's stash where the host's is (the same box, by the host's id)
cmd.go = function(a)
	local v = function(i) return vector():set(tonumber(a[i]) or 0, tonumber(a[i + 1]) or 0, tonumber(a[i + 2]) or 0) end
	jump(v(3))
	local bpos = v(6)
	local se = alife_create(BOX, bpos, tonumber(a[9]), tonumber(a[10]))
	if not se then return false, "no stash" end
	coop_spawn.map_pair(a[11], se.id)
	ctx.box_g = se.id
	return true, string.format("here, stash host %s = guest %d", a[11], se.id)
end

cmd.look = function(a)
	look_at(vector():set(tonumber(a[3]) or 0, tonumber(a[4]) or 0, tonumber(a[5]) or 0))
	return true, "looking"
end

cmd.open_box = function(a)
	local box = box_by(a[3])
	if not box then return false, "no box" end
	open_box(box)
	return true, "stash window open"
end

cmd.close_box = function()
	close_box()
	return true, "closed"
end

cmd.money_open = function()
	ctx.money_wnd = coop_trade.UICoopMoney()
	ctx.money_wnd:ShowDialog(true)
	return true, "window open"
end

cmd.money_send = function(a)
	local w = ctx.money_wnd
	if not (w and w:IsShown()) then return false, "no window" end
	w.amount:SetText(a[3])
	w:OnOk()
	return not w:IsShown(), w:IsShown() and "window still open" or ("sent " .. a[3])
end

coop_main.on_event("qa", function(a)
	if not active or is_host then return end
	local fn = cmd[a[2]]
	local ok, res, detail = pcall(function() if fn then return fn(a) end return false, "unknown " .. tostring(a[2]) end)
	if not ok then res, detail = false, tostring(res) end
	record("guest " .. a[1], res, detail)
	coop_main.send("qa_r", a[1], res and 1 or 0, detail or "")
end)

coop_main.on_event("qa_show", function(a)
	if active and not is_host then show(a[1] or "", tonumber(a[2]) or 12) end
end)

coop_main.on_event("qa_go", function()
	if active and not is_host then ctx.go = true end
end)

------------------------------------------------------------------ the host's part
local function ask(step, name, ...) coop_main.send("qa", step, name, ...) end

-- the guest's answers: kept, and checked against the host where the step says how
coop_main.on_event("qa_r", function(a)
	if not active or not is_host then return end
	local step, ok, detail = a[1], a[2] == "1", a[3] or ""
	local check = ctx.expect[step]
	if check then
		ctx.expect[step] = nil
		local good, why = check(ok, detail)
		record(step, good, why)
	else
		record(step, ok, "guest: " .. detail)
	end
end)

coop_main.on_event("qa_ready", function()
	if active and is_host then guest_ready = true end
end)

local STEPS = {
	{ 0, function()
		announce("ТЕСТ КООПЕРАТИВА: 7 шагов, около двух минут.\\nОба игрока переносятся на улицу в деревню новичков, рядом ставится тестовый тайник.", 8)
		local center, lv, gv = village()
		local dir, side = open_direction(center)
		local me = aside(center, 0, 0)
		local guest_pos = aside(center, side.x * 2.5, side.z * 2.5)
		-- the stash behind them, the creatures 6 m ahead where both look
		local bpos, blv = aside(center, -dir.x * 1.5 + side.x * 1.2, -dir.z * 1.5 + side.z * 1.2)
		ctx.spot = vector():set(center.x + dir.x * 6 + side.x * 1.2, center.y, center.z + dir.z * 6 + side.z * 1.2)
		jump(me)
		local se = alife_create(BOX, bpos, blv, gv)
		ctx.box = se and se.id
		record("0", se ~= nil, se and string.format("in %s, stash %d", level.name(), se.id) or "no stash")
		for _, sec in ipairs({ PUT, PUT, RACE }) do alife_create_item(sec, db.actor) end
		if se then
			local f = function(p) return string.format("%.2f", p.x), string.format("%.2f", p.y), string.format("%.2f", p.z) end
			local gx, gy, gz = f(guest_pos)
			local bx, by, bz = f(bpos)
			ask("0go", "go", gx, gy, gz, bx, by, bz, blv, gv, se.id)
			local sx, sy, sz = f(ctx.spot)
			after(1500, function() ask("0look", "look", sx, sy, sz) end)
		end
		-- both face where the creatures will be
		after(1500, function() look_at(ctx.spot) end)
	end },
	{ 12, function()
		announce("ШАГ 1. Зеркало: у ГОСТЯ в 6 м впереди (правое окно) появится плоть, которой у хоста нет.\\nЧерез 3–6 с она должна у гостя исчезнуть.", 11)
		ask("1", "extra")
	end },
	{ 24, function() ask("1", "extra_check") end },
	{ 26, function()
		announce("ШАГ 2. Зеркало: у ХОСТА появится плоть, оба игрока повернутся к ней.\\nЧерез 2–5 с она должна появиться и у гостя, на том же месте.", 11)
		local pos, lv = meeting_point()
		look_at(pos)
		ask("2look", "look", string.format("%.2f", pos.x), string.format("%.2f", pos.y), string.format("%.2f", pos.z))
		local se = alife_create(CREATURE, pos, lv, db.actor:game_vertex_id())
		ctx.hid = se and se.id
		if not se then record("2", false, "not made at the host") end
	end },
	{ 38, function() if ctx.hid then ask("2", "made_check", ctx.hid, CREATURE) end end },
	{ 40, function()
		announce("ШАГ 3. Хост убивает эту плоть.\\nУ гостя она тоже должна упасть мёртвой.", 8)
		local o = ctx.hid and level.object_by_id(ctx.hid)
		if o and o:alive() then o:kill(o) end
	end },
	{ 48, function() if ctx.hid then ask("3", "dead_check", ctx.hid) end end },
	{ 50, function()
		if not ctx.box then return end
		announce("ШАГ 4. Тайник открыт у обоих. Хост кладёт в него 2 колбасы и энергетик.\\nУ гостя (правое окно) они должны появиться в тайнике через 1–2 с.", 10)
		local box = level.object_by_id(ctx.box)
		open_box(box)
		ask("4open", "open_box", ctx.box)
		-- (the moves take a frame or two: the items are picked first, each once)
		local items = on_actor(PUT)
		items = { items[1], items[2], on_actor(RACE)[1] }
		for _, item in pairs(items) do
			if box then db.actor:transfer_item(item, box) end
		end
		after(1500, function()
			local gui = box and loot_gui(box)
			if gui then gui:LMode_RefreshInventories() end
		end)
	end },
	{ 60, function()
		local box = ctx.box and level.object_by_id(ctx.box)
		if not box then return end
		ctx.expect["4"] = function(ok, detail)
			local h = #in_box(box, PUT)
			return ok and tonumber(detail) == h, string.format("kolbasa: host %d, guest %s", h, detail)
		end
		ask("4", "box_count", ctx.box, PUT)
	end },
	{ 62, function()
		local box = ctx.box and level.object_by_id(ctx.box)
		if not box then return end
		announce("ШАГ 5. ГОСТЬ берёт из тайника одну колбасу.\\nУ хоста (левое окно) в тайнике должна остаться одна.", 10)
		ctx.before5 = #in_box(box, PUT)
		ask("5", "take", ctx.box, PUT)
	end },
	{ 73, function()
		local box = ctx.box and level.object_by_id(ctx.box)
		if not box then return end
		local now5 = #in_box(box, PUT)
		record("5", now5 == ctx.before5 - 1, string.format("host stash kolbasa %d -> %d", ctx.before5, now5))
		ctx.expect["6a"] = function(ok, detail)
			ctx.guest_race0 = tonumber(detail) or 0
			return ok, "guest has " .. detail .. " energy drinks before"
		end
		ask("6a", "has", RACE)
	end },
	{ 75, function()
		local box = ctx.box and level.object_by_id(ctx.box)
		if not box then return end
		announce("ШАГ 6. Хост и гость ОДНОВРЕМЕННО берут энергетик из тайника.\\nОн должен остаться только у хоста, у гостя — сообщение «забрал раньше вас».", 12)
		ctx.host_race0 = #on_actor(RACE)
		ask("6", "take", ctx.box, RACE)
		take_from(box, RACE)
	end },
	{ 88, function()
		if not ctx.box then return end
		ctx.expect["6b"] = function(ok, detail)
			local hg = #on_actor(RACE) - (ctx.host_race0 or 0)
			local gg = (tonumber(detail) or 0) - (ctx.guest_race0 or 0)
			return hg + gg == 1, string.format("got it: host +%d, guest +%d (one in all)", hg, gg)
		end
		ask("6b", "has", RACE)
	end },
	{ 90, function()
		close_box()
		ask("7close", "close_box")
		announce("ШАГ 7. Деньги: у ГОСТЯ открывается окно передачи денег, вводится 500 и нажимается «Передать».\\nУ хоста должно прийти «передал вам 500 руб.».", 12)
		ctx.money0 = db.actor:money()
		if coop_team.shared_money() then record("7", false, "shared money is on: nothing to give") return end
		ask("7", "money_open")
	end },
	{ 95, function() if not coop_team.shared_money() then ask("7s", "money_send", 500) end end },
	{ 101, function()
		if coop_team.shared_money() then return end
		local got = db.actor:money() - ctx.money0
		record("7", got == 500, string.format("host money +%d", got))
	end },
	{ 104, function()
		announce("ТЕСТ ЗАКОНЧЕН. Итоги — в coop_qa.txt обеих игр.", 15)
		record("end", true, "done")
	end },
}

------------------------------------------------------------------ the clock
local function actor_on_update()
	if not active then return end
	local now = time_global()
	local keep = {}
	for _, l in ipairs(later) do
		if now >= l[1] then pcall(l[2]) else keep[#keep + 1] = l end
	end
	later = keep
	-- the host makes it noon and clear, so the steps can be seen (the guest follows the host's time and weather)
	if not ctx.day_set and ctx.first_at and now > ctx.first_at + 3000 and coop_main.role == "host" then
		ctx.day_set = true
		local h, m = level.get_time_hours(), level.get_time_minutes()
		if h >= 19 or h < 7 then
			level.change_game_time(0, (12 - h - 1) % 24, 60 - m)
		end
		level.set_weather("w_clear1", true)
		coop_main.log(string.format("QA day: %02d:%02d -> %02d:%02d, clear", h, m, level.get_time_hours(),
			level.get_time_minutes()))
	end
	if not (ready_at and now > ready_at and coop_main.connected) then return end
	is_host = coop_main.role == "host"
	if not is_host then
		-- the guest says it is up until the host starts
		if not ctx.go and (not ctx.ready_sent or now > ctx.ready_sent + 3000) then
			ctx.ready_sent = now
			coop_main.send("qa_ready")
		end
		return
	end
	if not guest_ready then return end
	if not go_sent then
		go_sent = true
		coop_main.send("qa_go")
		started_at = now
	end
	while STEPS[next_step] and now >= started_at + STEPS[next_step][1] * 1000 do
		local s = STEPS[next_step]
		next_step = next_step + 1
		local ok, err = pcall(s[2])
		if not ok then record("step" .. tostring(next_step - 1), false, "script: " .. tostring(err)) end
	end
end

local function actor_on_first_update()
	ctx.first_at = time_global()
	-- the guest's character, the host's spawns and the mirror settle first
	ready_at = time_global() + 20000
	if not PANEL and get_hud() then
		PANEL = UICoopQa()
		get_hud():AddDialogToRender(PANEL)
	end
end

local function actor_on_net_destroy()
	if PANEL and get_hud() then get_hud():RemoveDialogToRender(PANEL) end
	PANEL = nil
end

function on_game_start()
	local f = io.open(app("coop_scenario.txt"), "r")
	active = f ~= nil
	if f then f:close() end
	if not active then return end
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
end
