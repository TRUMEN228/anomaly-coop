	{ 90, function()
		close_box()
		ask("7close", "close_box")
		announce("ШАГ 7. Деньги: у ГОСТЯ открывается окно передачи денег, вводится 500 и нажимается «Передать».\\nУ хоста должно прийти «передал вам 500 руб.».", 12)
		ctx.money0 = db.actor:money()
		if coop_team.shared_money() then record("7", false, "shared money is on: nothing to give") return end
		ask("7", "money_open")
	end },
	{ 95, function() if not coop_team.shared_money() then ask("7s", "money_send", 500) end end },
	{ 101, function()
		if coop_team.shared_money() then return end
		local got = db.actor:money() - ctx.money0
		record("7", got == 500, string.format("host money +%d", got))
	end },
	{ 104, function()
		announce("ШАГ 9. Разговор: хост заговаривает с Волком.\\nУ ГОСТЯ должно открыться такое же окно разговора с теми же репликами.", 10)
		-- zombies and mutants wander into the village: one that comes at the talk partner ends the talk (one who
		-- fights does not talk). The test sends them away first
		local cleared = 0
		for id, st in pairs(db.storage) do
			local o = st.object
			if o and id ~= AC_ID and o:alive() and not coop_player.is_puppet(id)
				and (IsMonster(o) or character_community(o) == "zombied")
				and o:position():distance_to(db.actor:position()) < 80 then
				coop_spawn.release_creature(id)
				cleared = cleared + 1
			end
		end
		coop_main.log("QA talk: " .. cleared .. " zombies and mutants sent away")
		-- the nearest loner who is no story character (their first words may end the talk at once) and not
		-- hostile; Wolf when there is no one else
		local list = {}
		for id, st in pairs(db.storage) do
			local o = st.object
			if o and IsStalker(o) and o:alive() and id ~= AC_ID and not coop_player.is_puppet(id) and not get_object_story_id(id)
				and o:relation(db.actor) ~= game_object.enemy and not o:best_enemy() and not o:wounded()
				-- (a meet lets only a squad's leader talk: the others send the player to it)
				and (function() local sq = get_object_squad(o) return not sq or sq:commander_id() == id end)()
				and o:position():distance_to(db.actor:position()) < 40 then
				list[#list + 1] = o
			end
		end
		local me = db.actor:position()
		table.sort(list, function(x, y) return x:position():distance_to(me) < y:position():distance_to(me) end)
		local wolf = get_story_object("esc_2_12_stalker_wolf")
		if wolf and wolf:alive() then list[#list + 1] = wolf end
		local tried = {}
		ctx.expect["9"] = function(ok, detail) return ok and detail == "shown", "guest's talk window copy: " .. detail end
		local function try(i)
			local npc = list[i]
			if not npc or i > 2 then
				record("9host", false, "no one would talk: " .. table.concat(tried, ", "))
				return
			end
			ctx.talk_npc = npc
			-- as a player does: right next to them (a meet lets one talk only close by)
			local np = npc:position()
			local d = vector():set(db.actor:position()):sub(np)
			d.y = 0
			if d:magnitude() > 0.1 then d:normalize() else d = vector():set(1, 0, 0) end
			jump(aside(np, d.x * 1.5, d.z * 1.5))
			look_at(np)
			-- (a raised gun makes them raise theirs)
			db.actor:activate_slot(0)
			-- the meet decides on its own update whether the player is close enough to talk to: a talk started
			-- before it has seen the jump is ended by it at once (xr_meet's process_npc_usability)
			after(1500, function()
			npc:enable_talk()
			db.actor:run_talk_dialog(npc, false)
			for _, ms in ipairs({ 0, 100, 300, 600 }) do
				after(ms, function()
					coop_main.log(string.format("QA trace: %d ms: host talking %s, %s talking %s, use %s", ms,
						tostring(db.actor:is_talking()), npc:section(), tostring(npc:is_talking()),
						tostring(db.storage[npc:id()] and db.storage[npc:id()].meet and db.storage[npc:id()].meet.meet_manager.use)))
				end)
			end
			after(1200, function()
				local enemy = npc:best_enemy()
				local st = db.storage[npc:id()]
				local mm = st and st.meet and st.meet.meet_manager
				local sq = get_object_squad(npc)
				tried[#tried + 1] = string.format("%s %s (meet use %s, leader %s, %.1f m%s)", npc:section(),
					db.actor:is_talking() and "talks" or "ended", tostring(mm and mm.use),
					tostring(not sq or sq:commander_id() == npc:id()), npc:position():distance_to(db.actor:position()),
					enemy and (", fights " .. enemy:section()) or "")
				if db.actor:is_talking() then
					record("9host", true, "talking: " .. table.concat(tried, ", "))
					after(1500, function() ask("9", "mirror_shown") end)
				else
					try(i + 1)
				end
			end)
			end)
		end
		focus("A")
		after(1500, function() try(1) end)
	end },
	{ 112, function()
		announce("ШАГ 10. Подарок в разговоре: хост получает пиво, пока говорит.\\nГостю тоже должно прийти пиво («Вы тоже получили»).", 8)
		ctx.expect["10a"] = function(ok, detail) ctx.beer0 = tonumber(detail) or 0 return ok, "guest beers before: " .. detail end
		ask("10a", "has", "beer")
		after(300, function() alife_create_item("beer", db.actor) end)
	end },
	{ 118, function()
