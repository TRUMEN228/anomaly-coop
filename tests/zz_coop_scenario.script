		coop_main.set_option("ff", true)
		ask("31pre", "ff_count")
		ctx.expect["31pre"] = function(ok, detail) ctx.ff0 = tonumber(detail) return ok, "guest's friendly fire before: " .. detail end
		after(2000, function()
			local id = coop_player.get_puppet_id()
			local p = id and level.object_by_id(id)
			if not p then return end
			for _ = 1, 2 do
				local h = hit()
				h.type = hit.wound
				h.power = 0.05
				h.impulse = 0
				h.draftsman = db.actor
				h.direction = vector():set(0, 0, 1)
				p:hit(h)
			end
		end)
	end },
	{ 424, function()
		ctx.expect["31"] = function(ok, detail)
			local n = tonumber(detail) or -1
			return ok and n > (ctx.ff0 or 0), string.format("the guest took %s friendly hits (before %s)", detail, tostring(ctx.ff0))
		end
		ask("31", "ff_count")
		coop_main.set_option("ff", false)
	end },
	{ 426, function()
		announce("ШАГ 32. Быстрые сохранения: хост сохраняется пять раз подряд.\\nИгра не вылетает, модель гостя у хоста остаётся той же (её больше не пересоздают).", 6)
		ctx.puppet0 = coop_player.get_puppet_id()
		for i = 0, 4 do after(i * 700, function() exec_console_cmd("save coop_qa_quick") end) end
	end },
	{ 434, function()
		local id = coop_player.get_puppet_id()
		local here = id and level.object_by_id(id)
		record("32", here ~= nil and id == ctx.puppet0, string.format("after 5 quick saves: puppet %s (before %s), %s",
			tostring(id), tostring(ctx.puppet0), here and "here" or "not here"))
	end },
	{ 436, function()
		announce("ШАГ 33. Персонаж гостя в сохранениях хоста: гость получает 777 рублей.\\nХост знает его новые деньги — загрузка сохранения вернёт персонажа гостя таким, каким он был при сохранении.", 6)
		ask("33give", "add_money", "777")
	end },
	{ 437, function()
		ctx.expect["33money"] = function(ok, detail) ctx.guest_money = tonumber(detail) return ok, "guest's money: " .. detail end
		ask("33money", "money")
	end },
	{ 444, function()
		local m = coop_session.partner_char_money and coop_session.partner_char_money()
		record("33", m ~= nil and m == ctx.guest_money, string.format("the guest's money the host's save keeps: %s (guest has %s)",
			tostring(m), tostring(ctx.guest_money)))
	end },
	{ 446, function()
		announce("ШАГ 34. Быстрый канал: движение и существа идут по UDP у обоих (с потерями и задержкой реле).", 4)
		local st = rawget(_G, "coop_link_net_status") and coop_link_net_status() or "none"
		record("34host", st:find("udp on") ~= nil, "host's link: " .. st)
		ctx.expect["34"] = function(ok, detail) return ok and detail:find("udp on") ~= nil, "guest's link: " .. detail end
		ask("34", "net_status")
	end },
	{ 450, function()
		announce("ШАГ 35. Панель хоста и консоль: хост открывает панель, вызывает coop_status и выдаёт гостю два хлеба.", 6)
		exec_console_cmd("coop_status")
		coop_admin.open_panel()
		ctx.expect["35pre"] = function(ok, detail) ctx.bread0 = tonumber(detail) return ok, "guest's bread before: " .. detail end
		ask("35pre", "has", "bread")
	end },
	{ 452, function()
		record("35cmd", coop_admin.last_console == "coop_status", "the engine's console passed: " .. tostring(coop_admin.last_console))
		record("35panel", coop_admin.panel_shown(), "the panel is shown: " .. tostring(coop_admin.panel_shown()))
		local ok, text = coop_admin.give("bread", 2, true)
		record("35give", ok, text)
	end },
	{ 457, function()
		coop_admin.close_panel()
		ctx.expect["35"] = function(ok, detail)
			local n = tonumber(detail) or -1
			return ok and n == (ctx.bread0 or 0) + 2, string.format("guest's bread: %s (before %s, +2)", detail, tostring(ctx.bread0))
		end
		ask("35", "has", "bread")
	end },
	{ 459, function()
		announce("ШАГ 36. Хост переносит гостя к себе кнопкой панели.", 4)
		local ok, text = coop_admin.tp_partner_here()
		record("36go", ok, text)
	end },
	{ 464, function()
		local r = coop_player.get_remote()
		local d = r and r.pos and db.actor:position():distance_to(r.pos) or -1
		record("36", d >= 0 and d < 4, string.format("the guest is %.1f m from the host", d))
	end },
	{ 466, function()
		announce("ТЕСТ ЗАКОНЧЕН. Итоги — в coop_qa.txt обеих игр.", 15)
		record("end", true, "done")
	end },
}

------------------------------------------------------------------ the clock
local function actor_on_update()
	if not active then return end
	local now = time_global()
	local keep = {}
	for _, l in ipairs(later) do
		if now >= l[1] then pcall(l[2]) else keep[#keep + 1] = l end
	end
	later = keep
	-- the host makes it noon and clear, so the steps can be seen (the guest follows the host's time and weather)
	if not ctx.day_set and ctx.first_at and now > ctx.first_at + 3000 and coop_main.role == "host" then
		ctx.day_set = true
		local h, m = level.get_time_hours(), level.get_time_minutes()
		if h >= 19 or h < 7 then
			level.change_game_time(0, (12 - h - 1) % 24, 60 - m)
		end
		level.set_weather("w_clear1", true)
		-- a jump: the guest's sky follows at once
		if coop_world.weather_jumped then coop_world.weather_jumped() end
		coop_main.log(string.format("QA day: %02d:%02d -> %02d:%02d, clear", h, m, level.get_time_hours(),
			level.get_time_minutes()))
	end
	if not (ready_at and now > ready_at and coop_main.connected) then return end
	is_host = coop_main.role == "host"
	if not is_host then
		if ctx.go then watch_jumps(now) end
		-- the guest says it is up until the host starts
		if not ctx.go and (not ctx.ready_sent or now > ctx.ready_sent + 3000) then
			ctx.ready_sent = now
			coop_main.send("qa_ready")
		end
		return
	end
	if not guest_ready then return end
	if not go_sent then
		go_sent = true
		coop_main.send("qa_go")
		started_at = now
	end
	while STEPS[next_step] and now >= started_at + STEPS[next_step][1] * 1000 do
		local s = STEPS[next_step]
		next_step = next_step + 1
		local ok, err = pcall(s[2])
		if not ok then record("step" .. tostring(next_step - 1), false, "script: " .. tostring(err)) end
	end
end

local function actor_on_first_update()
	ctx.first_at = time_global()
	-- the guest's character, the host's spawns and the mirror settle first
	ready_at = time_global() + 20000
	if not PANEL and get_hud() then
		PANEL = UICoopQa()
		get_hud():AddDialogToRender(PANEL)
	end
end

local function actor_on_net_destroy()
	if PANEL and get_hud() then get_hud():RemoveDialogToRender(PANEL) end
	PANEL = nil
end

-- step 25: the host's flesh is hurt only by the guest (its hits come by the engine, not as a hit here): the farm's
-- own creatures would kill it first
local function flesh_25_only_guest(obj, shit, bone_id, flags)
	if ctx.h25 and obj and obj:id() == ctx.h25 and coop_main.role == "host" then flags.ret_value = false end
end

function on_game_start()
	RegisterScriptCallback("monster_on_before_hit", flesh_25_only_guest)
	local f = io.open(app("coop_scenario.txt"), "r")
	active = f ~= nil
	if f then f:close() end
	if not active then return end
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
end
