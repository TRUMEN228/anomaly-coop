		end
		ask("12", "trader_check")
	end },
	{ 139, function()
		local box = ctx.box and level.object_by_id(ctx.box)
		if not box then return end
		announce("ШАГ 13. Состояние вещи: хост кладёт в тайник пистолет с износом 40 %.\\nГость берёт его (его копия как новая) — после взятия у гостя он тоже должен стать изношенным.", 12)
		alife_create_item("wpn_pm", db.actor, { cond = 0.4 })
		after(800, function()
			local pm = on_actor("wpn_pm")[1]
			if pm then
				-- (what the host's has is what the guest's must take)
				pm:set_condition(0.4)
				ctx.pm_cond = pm:condition()
				db.actor:transfer_item(pm, box)
			end
		end)
