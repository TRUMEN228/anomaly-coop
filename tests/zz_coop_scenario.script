--[[
	dev only: a test both games play together, step by step (active when appdata\coop_scenario.txt exists).
	Before each step a banner in both games says what is about to happen and what to look for, so a person can
	watch along. The host leads: "qa" events tell the guest what to do or to look, "qa_r" brings its answers back.
	Results: "QA <step> PASS|FAIL <detail>" in coop_log.txt and appdata\coop_qa.txt of each game.
	The runner (tests\scenario.ps1) copies this file in, converted to cp1251.
--]]

local active = false
local is_host = false
local ready_at = nil          -- this game's own wait after the first update
local guest_ready = false     -- host: the guest said it is up
local go_sent = false
local started_at = nil        -- host: the scenario's clock
local next_step = 1
local later = {}              -- { at, fn }: things to do a moment later
local ctx = { expect = {} }   -- what the steps share
local banner = { text = "", until_t = 0 }
local PANEL = nil

local CREATURE = "flesh_weak"      -- big and slow: easy to see
local PUT = "kolbasa"         -- not in the sandbox gear: counts start from what the test puts in
local RACE = "energy_drink"
local JUMP_SPEED = 15         -- m/s: nobody runs this fast; faster is a jump
local JUMP_SETTLE = 15000     -- the first seconds (a move of both, everyone put in place) do not count

local function app(name) return getFS():update_path("$app_data_root$", name) end

local function record(step, ok, detail)
	local line = string.format("QA %s %s %s", step, ok and "PASS" or "FAIL", detail or "")
	coop_main.log(line)
	local f = io.open(app("coop_qa.txt"), "a")
	if f then f:write(line .. "\n") f:close() end
end

local function after(ms, fn) later[#later + 1] = { time_global() + ms, fn } end

------------------------------------------------------------------ the banner
local function show(text, secs)
	banner.text, banner.until_t = text, time_global() + (secs or 12) * 1000
end

-- which game's window the watcher (scenario.ps1) makes the active one: a game without it closes a window as it
-- opens (a talk)
local function focus(n)
	local f = io.open(app("coop_qa_focus.txt"), "w")
	if f then f:write(n) f:close() end
end

-- on both screens
local function announce(text, secs)
	show(text, secs)
	coop_main.send("qa_show", text, secs or 12)
	local f = io.open(app("coop_qa_steps.txt"), "a")
	if f then
		local first = text:gsub("\\n.*$", "")
		f:write(os.time() .. "|" .. first .. "\n")
		f:close()
	end
end

class "UICoopQa" (CUIScriptWnd)

function UICoopQa:__init() super()
	local xml = utils_xml.get_hud_xml()
	self.text = xml:InitTextWnd("companion_list:slot:distance", self)
	local ok, font = pcall(function() return GetFontGraffiti22Russian() end)
	self.text:SetFont(ok and font or GetFontMedium())
	self.text:SetTextComplexMode(true)
	self.text:SetWndPos(vector2():set(112, 30))
	self.text:SetWndSize(vector2():set(800, 180))
	self.text:SetTextAlignment(2)
	self.text:SetVTextAlignment(0)
	self.text:SetTextColor(GetARGB(255, 255, 220, 120))
	self.shown_text = nil
end

function UICoopQa:__finalize() end

function UICoopQa:Update()
	CUIScriptWnd.Update(self)
	local text = time_global() < banner.until_t and banner.text or ""
	if text ~= self.shown_text then
		self.shown_text = text
		self.text:SetText(text)
	end
end

------------------------------------------------------------------ helpers
local function ahead(dist)
	local dir = device().cam_dir
	local p = db.actor:position()
	local pos = vector():set(p.x + dir.x * dist, p.y + 0.5, p.z + dir.z * dist)
	local lv = level.vertex_id(pos)
	if not lv or lv >= 4294967295 then return vector():set(p), db.actor:level_vertex_id() end
	return level.vertex_position(lv), lv
end

local function nearest_box()
	local best, bd = nil, 40
	local here = db.actor:position()
	for id = 1, 65534 do
		local o = level.object_by_id(id)
		if o and IsInvbox(o) and not coop_trade.is_exchange_box(id) then
			local d = o:position():distance_to(here)
			if d < bd then best, bd = o, d end
		end
	end
	return best
end

local function in_box(box, sec)
	local list = {}
	box:iterate_inventory_box(function(_, o) if o:section() == sec then list[#list + 1] = o end end, box)
	return list
end

local function on_actor(sec)
	local list = {}
	db.actor:iterate_inventory(function(_, o) if o:section() == sec then list[#list + 1] = o end end, nil)
	return list
end

-- the player turns to face a point
local function look_at(pos)
	local dir = vector():set(pos):sub(db.actor:position())
	db.actor:set_actor_direction(-dir:getH())
end

-- a point both players see: between them, a few metres aside
local function meeting_point()
	if ctx.spot then
		local lv = level.vertex_id(ctx.spot)
		if lv and lv < 4294967295 then return level.vertex_position(lv), lv end
	end
	local a = db.actor:position()
	local r = coop_player.get_remote()
	local b = r and r.level == level.name() and r.pos or a
	local mid = vector():set((a.x + b.x) / 2, a.y + 0.5, (a.z + b.z) / 2)
	local side = vector():set(b.z - a.z, 0, a.x - b.x)
	if side:magnitude() < 0.5 then side = device().cam_dir end
	side:normalize()
	local pos = vector():set(mid.x + side.x * 6, mid.y, mid.z + side.z * 6)
	local lv = level.vertex_id(pos)
	if not lv or lv >= 4294967295 then return ahead(6) end
	return level.vertex_position(lv), lv
end

local function loot_gui(box)
	local gui = ui_inventory.GUI
	return gui and gui:IsShown() and gui.mode == "loot" and gui.npc_id == box:id() and gui or nil
end

local function open_box(box)
	if not loot_gui(box) then ui_inventory.start("loot", box) end
end

local function close_box()
	local gui = ui_inventory.GUI
	if gui and gui:IsShown() then gui:Close() end
end

-- as a player does it: the loot window open, the item moved, the window read again (which reports the take)
local function take_from(box, sec)
	local item = in_box(box, sec)[1]
	if not item then return false end
	local open = loot_gui(box) ~= nil
	open_box(box)
	-- (a window that has just opened reads its lists on its own: the item moves once it has)
	after(open and 0 or 1000, function()
		if item:parent() and item:parent():id() == box:id() then box:transfer_item(item, db.actor) end
		after(500, function()
			local gui = loot_gui(box)
			if gui then gui:LMode_RefreshInventories() end
		end)
	end)
	return true
end

local VILLAGE = "esc_smart_terrain_2_12"
local BOX = "inv_backpack"

-- a spot of open ground: the village's middle, or where the player stands on another level
local FARM = "esc_smart_terrain_5_7"  -- the farm with the mechanic: loners, no one hostile

local function village(name)
	local smart = SIMBOARD and SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[name or VILLAGE]
	if smart and level.name() == "l01_escape" then
		return vector():set(smart.position), smart.m_level_vertex_id, smart.m_game_vertex_id
	end
	return vector():set(db.actor:position()), db.actor:level_vertex_id(), db.actor:game_vertex_id()
end

-- a level vertex near pos, dx/dz metres aside
local function aside(pos, dx, dz)
	local p = vector():set(pos.x + dx, pos.y + 0.5, pos.z + dz)
	local lv = level.vertex_id(p)
	if not lv or lv >= 4294967295 then return vector():set(pos), level.vertex_id(pos) end
	return level.vertex_position(lv), lv
end

local function walkable(from, dir, len)
	for d = 1, len, 0.7 do
		local lv = level.vertex_id(vector():set(from.x + dir.x * d, from.y + 0.5, from.z + dir.z * d))
		if not lv or lv >= 4294967295 then return false end
	end
	return true
end

-- the first of eight directions with 9 m of open ground ahead and room for the partner beside
local function open_direction(center)
	for i = 0, 7 do
		local a = i * math.pi / 4
		local dir = vector():set(math.cos(a), 0, math.sin(a))
		local side = vector():set(-dir.z, 0, dir.x)
		if walkable(center, dir, 9) and walkable(center, side, 3) then return dir, side end
	end
	return vector():set(1, 0, 0), vector():set(0, 0, 1)
end

-- a jump on the level is a fast travel to the host's sync: this one is the test's own
local function jump(pos)
	db.actor:set_actor_position(pos)
	if coop_session.alive_write then coop_session.alive_write(true) end
end

local function box_by(id)
	local o = level.object_by_id(coop_spawn.L(id) or -1)
	return o and IsInvbox(o) and o or nil
end

------------------------------------------------------------------ the guest's part
local cmd = {}

cmd.extra = function()
	local pos, lv = ahead(6)
	local se = alife_create(CREATURE, pos, lv, db.actor:game_vertex_id())
	ctx.extra = se and se.id
	return se ~= nil, se and ("made " .. se.id) or "not made"
end

cmd.extra_check = function()
	if not ctx.extra then return false, "never made" end
	local gone = not level.object_by_id(ctx.extra) and not alife_object(ctx.extra)
	return gone, gone and "gone" or "still here"
end

cmd.made_check = function(a)
	local id = coop_spawn.L(a[3])
	local o = id and level.object_by_id(id)
	local ok = o ~= nil and o:section() == a[4]
	return ok, ok and string.format("host %s = guest %d", a[3], id) or "not here"
end

cmd.dead_check = function(a)
	local id = coop_spawn.L(a[3])
	local o = id and level.object_by_id(id)
	if not o then return false, "not here" end
	return not o:alive(), o:alive() and "alive" or "dead"
end

cmd.box_count = function(a)
	local box = box_by(a[3])
	if not box then return false, "no box" end
	return true, tostring(#in_box(box, a[4]))
end

cmd.take = function(a)
	local box = box_by(a[3])
	if not box then return false, "no box" end
	local ok = take_from(box, a[4])
	return ok, ok and "taken" or "none in the box"
end

cmd.has = function(a) return true, tostring(#on_actor(a[3])) end

-- next to the host, and the test's stash where the host's is (the same box, by the host's id)
cmd.go = function(a)
	local v = function(i) return vector():set(tonumber(a[i]) or 0, tonumber(a[i + 1]) or 0, tonumber(a[i + 2]) or 0) end
	jump(v(3))
	local bpos = v(6)
	local se = alife_create(BOX, bpos, tonumber(a[9]), tonumber(a[10]))
	if not se then return false, "no stash" end
	coop_spawn.map_pair(a[11], se.id)
	ctx.box_g = se.id
	return true, string.format("here, stash host %s = guest %d", a[11], se.id)
end

-- every creature near the host, compared with this game: missing, extra, elsewhere, alive at one only
local CENSUS_RADIUS = 50
local function creatures_near(pos, radius)
	local list = {}
	for id, st in pairs(db.storage) do
		local o = st.object
		if o and id ~= AC_ID and (IsStalker(o) or IsMonster(o)) and not coop_player.is_puppet(id)
			and o:position():distance_to(pos) < radius then
			list[#list + 1] = o
		end
	end
	return list
end

cmd.census = function(a)
	local center = vector():set(tonumber(a[3]) or 0, tonumber(a[4]) or 0, tonumber(a[5]) or 0)
	local listed, missing, off, life, far = {}, {}, {}, {}, 0
	for e in (a[6] or ""):gmatch("[^;]+") do
		local hid, sec, x, z, alive = e:match("^(%d+),([^,]+),([^,]+),([^,]+),(%d)$")
		hid = tonumber(hid)
		if hid then
			local id = coop_spawn.L(hid)
			local o = id and level.object_by_id(id)
			if id then listed[id] = true end
			if not (o and o:section() == sec) then
				missing[#missing + 1] = sec .. "#" .. hid
			else
				local p = o:position()
				local d = math.sqrt((p.x - tonumber(x)) ^ 2 + (p.z - tonumber(z)) ^ 2)
				if (alive == "1") ~= o:alive() then life[#life + 1] = string.format("%s#%d %s here", sec, hid, o:alive() and "alive" or "dead") end
				if d > 4 then off[#off + 1] = string.format("%s#%d %.0fm", sec, hid, d) end
				far = math.max(far, d)
			end
		end
	end
	local extra = {}
	for _, o in ipairs(creatures_near(center, CENSUS_RADIUS - 5)) do
		if not listed[o:id()] then extra[#extra + 1] = o:section() .. "#" .. o:id() .. (o:alive() and "" or "(dead)") end
	end
	local ok = #missing == 0 and #extra == 0 and #off == 0 and #life == 0
	return ok, string.format("missing %d [%s]; extra %d [%s]; elsewhere %d [%s]; life %d [%s]", #missing,
		table.concat(missing, " "), #extra, table.concat(extra, " "), #off, table.concat(off, " "), #life, table.concat(life, " "))
end

-- what a trader sells: its inventory but what it wears and holds
local function goods_count(npc)
	local keep = {}
	for slot = 0, 13 do
		local o = npc:item_in_slot(slot)
		if o then keep[o:id()] = true end
	end
	local w = npc:active_item()
	if w then keep[w:id()] = true end
	local n = 0
	npc:iterate_inventory(function(_, o) if o and not keep[o:id()] then n = n + 1 end end, nil)
	return n
end

local function trader()
	local npc = get_story_object("esc_m_trader")
	return npc and npc:alive() and npc or nil
end

cmd.mirror_shown = function()
	local shown = rawget(_G, "coop_talk_mirror_shown") and coop_talk_mirror_shown() or false
	return true, shown and "shown" or "not shown"
end

-- the guest turns to the trader as a player does (npc_on_use asks the host for its goods)
cmd.trader = function()
	local npc = trader()
	if not npc then return false, "no trader here" end
	SendScriptCallback("npc_on_use", npc, db.actor)
	return true, "asked " .. npc:section()
end

-- what the guest's trader has, and whether it would sell it (the trade window lists only what it sells)
cmd.trader_check = function()
	local npc = trader()
	if not npc then return false, "no trader here" end
	pcall(trade_manager.update, npc)
	local p = trade_manager.get_trade_profile and trade_manager.get_trade_profile(npc:id())
	return true, string.format("%d;%s", goods_count(npc), tostring(p and p.current_sell_condition))
end

-- the guest's copy of the pistol as new (its own roll), then taken: the host's state must come
cmd.take_fresh = function(a)
	local box = box_by(a[3])
	if not box then return false, "no box" end
	local item = in_box(box, a[4])[1]
	if not item then return false, "none in the box" end
	item:set_condition(1)
	ctx.taken_id = item:id()
	local ok = take_from(box, a[4])
	return ok, ok and "taken as new" or "not taken"
end

cmd.cond = function(a)
	local item = ctx.taken_id and level.object_by_id(ctx.taken_id)
	if not (item and item:parent() and item:parent():id() == AC_ID) then item = on_actor(a[3])[1] end
	if not item then return false, "none on me" end
	return true, string.format("%.2f", item:condition())
end

-- step 14: the bandits leave the host alone, so it is the guest's puppet they shoot at (with the host there too
-- they may fight only it, or the farm's people, and the step shows nothing)
local function bandits_ignore_host(obj, enemy, flags)
	if ctx.bandit_ids and ctx.bandit_ids[obj:id()] and enemy:id() == AC_ID then
		flags.override = true
		flags.result = false
	end
end

-- the guest in the fight: who fights it here, the host's hits it took, its creatures' own hits on it undone
cmd.combat = function()
	local on_me = 0
	for _, st in pairs(db.storage) do
		local o = st.object
		local e = o and o:alive() and IsStalker(o) and o:best_enemy()
		if e and e:id() == AC_ID then on_me = on_me + 1 end
	end
	local _, got, blocked, fought = coop_combat.counts()
	return fought > 0 and got > 0, string.format("fought here %d times (%d now), %d hits from the host taken, %d own blocked",
		fought, on_me, got, blocked)
end

-- items on the ground of this section within r of a point
local function ground_items(sec, pos, r)
	local list = {}
	level.iterate_nearest(pos, r, function(o)
		if o and o:section() == sec and not o:parent() then list[#list + 1] = o end
	end)
	return list
end

local function vpos(a, i) return vector():set(tonumber(a[i]) or 0, tonumber(a[i + 1]) or 0, tonumber(a[i + 2]) or 0) end

cmd.ground = function(a)
	return true, tostring(#ground_items(a[3], vpos(a, 4), 3))
end

cmd.ground_r = function(a)
	return true, tostring(#ground_items(a[3], vpos(a, 4), tonumber(a[7]) or 3))
end

-- the guest picks an item up from the ground, as a player does
cmd.pickup = function(a)
	local item = ground_items(a[3], vpos(a, 4), 4)[1]
	if not item then return false, "none on the ground here" end
	db.actor:take_item(item)
	return true, "picked up"
end

-- the guest drops an item of its own (made first: one just made goes to no one)
cmd.drop_new = function(a)
	alife_create_item(a[3], db.actor)
	after(1500, function()
		local list = on_actor(a[3])
		local item = list[#list]
		if item then db.actor:drop_item(item) end
	end)
	return true, "dropping"
end

-- what a body here holds (the host's id)
cmd.body = function(a)
	local obj = level.object_by_id(coop_spawn.L(tonumber(a[3])) or -1)
	if not obj then return false, "no body here" end
	if obj:alive() then return false, "alive here" end
	local list = {}
	obj:iterate_inventory(function(_, o) if o then list[#list + 1] = o:section() end end, obj)
	table.sort(list)
	return true, table.concat(list, ",")
end

cmd.weather = function() return true, string.format("%s at %02d:%02d", tostring(level.get_weather()),
	level.get_time_hours(), level.get_time_minutes()) end

-- PDA messages (r14): the guest's own one and one both games make
local function pda(text) db.actor:give_game_news("QA", text, "ui_inGame2_PD_Lider", 0, 4000) end
local function pda_count(text) return rawget(_G, "coop_news_count") and coop_news_count(text) or -1 end
cmd.news_say = function()
	pda("QA news from the guest")
	pda("QA news both games make")
	return true, "said"
end
cmd.news = function()
	return true, string.format("%d,%d,%d", pda_count("QA news from the host"), pda_count("QA news from the guest"),
		pda_count("QA news both games make"))
end

-- money (r15): how much the guest has; a sum given to the host
cmd.money = function() return true, tostring(db.actor:money()) end
-- the link's own view (engine r20: the UDP side of a TCP link)
cmd.net_status = function() return true, rawget(_G, "coop_link_net_status") and coop_link_net_status() or "none" end
-- money for this player only (not a transfer)
cmd.add_money = function(a) db.actor:give_money(tonumber(a[3]) or 0) return true, "added" end
cmd.give_money = function(a)
	local n = tonumber(a[3]) or 0
	db.actor:give_money(-n)
	coop_money_give(n)
	return true, "gave " .. n
end

-- this player hits a creature (r15: the engine takes the hit to the host)
cmd.hurt = function(a)
	local id = coop_spawn.L(a[3])
	local o = id and level.object_by_id(id)
	if not (o and o:alive()) then return false, "not here or dead" end
	local h = hit()
	h.type = hit.wound
	h.power = tonumber(a[4]) or 0.3
	h.impulse = 0
	h.draftsman = db.actor
	h.direction = vector():set(0, 0, 1)
	o:hit(h)
	return true, string.format("%.2f", o:alive() and o.health or 0)
end

-- a gift (r16): a worn pistol made here, then given to the host as its whole state
local GIFT, GIFT_COND = "wpn_pm", 0.55
-- the pistols this player has: id -> condition
local function pistols()
	local t = {}
	db.actor:iterate_inventory(function(_, o)
		if o and o:section() == GIFT then t[o:id()] = o:condition() end
	end, db.actor)
	return t
end
cmd.gift_make = function()
	alife_create_item(GIFT, db.actor, { cond = GIFT_COND })
	return true, "made"
end
cmd.gift_give = function()
	-- the newest pistol: the one just made
	local id
	for i in pairs(pistols()) do if not id or i > id then id = i end end
	local item = id and level.object_by_id(id)
	if not item then return false, "no pistol here" end
	local cond = item:condition()
	if not coop_items_gift(id) then return false, "the engine did not take it" end
	local se = alife_object(id)
	if se then alife_release(se) end
	return true, string.format("%.2f", cond)
end

-- story flags (r18)
cmd.has_info = function(a) return true, has_alife_info(a[3]) and "1" or "0" end
cmd.give_info = function(a) db.actor:give_info_portion(a[3]) return true, "given" end
-- a trader's goods of these sections here: "a,b"
cmd.trader_counts = function(a)
	local npc = trader()
	if not npc then return false, "no trader here" end
	local c = { [a[3]] = 0, [a[4]] = 0 }
	npc:iterate_inventory(function(_, o) if o and c[o:section()] then c[o:section()] = c[o:section()] + 1 end end, npc)
	return true, string.format("%d,%d", c[a[3]], c[a[4]])
end
-- friendly fire this player took from the partner
cmd.ff_count = function() return true, tostring(coop_team.ff_count and coop_team.ff_count() or -1) end

-- is this game asleep (the sleep's dark screen, the controls off)
cmd.asleep = function()
	-- (the partner's sleep ran here: not only the flag)
	local ran = coop_team.partner_sleeps and coop_team.partner_sleeps() or 0
	return true, (has_alife_info("actor_is_sleeping") and ran > 0) and "1" or "0"
end

-- the guest's clock runs two hours ahead of the host's (the engine puts it back, r14)
cmd.ahead = function()
	level.change_game_time(0, 2, 0)
	return true, string.format("%02d:%02d", level.get_time_hours(), level.get_time_minutes())
end

-- to another place next to the host, looking where the host looks
cmd.goto = function(a)
	local v = function(i) return vector():set(tonumber(a[i]) or 0, tonumber(a[i + 1]) or 0, tonumber(a[i + 2]) or 0) end
	jump(v(3))
	ctx.settle_until = time_global() + JUMP_SETTLE
	after(1500, function() look_at(v(6)) end)
	return true, "moved"
end

cmd.look = function(a)
	look_at(vector():set(tonumber(a[3]) or 0, tonumber(a[4]) or 0, tonumber(a[5]) or 0))
	return true, "looking"
end

cmd.open_box = function(a)
	local box = box_by(a[3])
	if not box then return false, "no box" end
	open_box(box)
	return true, "stash window open"
end

cmd.close_box = function()
	close_box()
	return true, "closed"
end

cmd.money_open = function()
	ctx.money_wnd = coop_trade.UICoopMoney()
	ctx.money_wnd:ShowDialog(true)
	return true, "window open"
end

cmd.money_send = function(a)
	local w = ctx.money_wnd
	if not (w and w:IsShown()) then return false, "no window" end
	w.amount:SetText(a[3])
	w:OnOk()
	return not w:IsShown(), w:IsShown() and "window still open" or ("sent " .. a[3])
end

coop_main.on_event("qa", function(a)
	if not active or is_host then return end
	local fn = cmd[a[2]]
	local ok, res, detail = pcall(function() if fn then return fn(a) end return false, "unknown " .. tostring(a[2]) end)
	if not ok then res, detail = false, tostring(res) end
	record("guest " .. a[1], res, detail)
	coop_main.send("qa_r", a[1], res and 1 or 0, detail or "")
end)

coop_main.on_event("qa_show", function(a)
	if active and not is_host then show(a[1] or "", tonumber(a[2]) or 12) end
end)

coop_main.on_event("qa_go", function()
	if active and not is_host then
		ctx.go = true
		ctx.go_at = time_global()
	end
end)

local jumps, last_seen, next_look = {}, {}, 0

local function watch_jumps(now)
	if now < next_look then return end
	-- a move of both players puts everyone in place again: not counted for a while
	if ctx.settle_until and now < ctx.settle_until then
		next_look, last_seen, ctx.last_look = now + 200, {}, nil
		return
	end
	local dt = (now - (ctx.last_look or now)) / 1000
	ctx.last_look, next_look = now, now + 200
	local here = db.actor:position()
	local seen = {}
	for id, st in pairs(db.storage) do
		local o = st.object
		if o and id ~= AC_ID and (IsStalker(o) or IsMonster(o)) and o:alive() and not coop_player.is_puppet(id)
			and o:position():distance_to(here) < 60 then
			local p = vector():set(o:position())
			seen[id] = p
			local last = last_seen[id]
			if last and dt > 0.05 and dt < 1 then
				local d = last:distance_to(p)
				if d / dt > JUMP_SPEED then
					jumps[#jumps + 1] = { t = (now - ctx.go_at) / 1000, sec = o:section(), id = id, d = d }
				end
			end
		end
	end
	last_seen = seen
end

cmd.jumps = function()
	local counted, list = 0, {}
	for _, j in ipairs(jumps) do
		if j.t * 1000 > JUMP_SETTLE then
			counted = counted + 1
			if #list < 8 then list[#list + 1] = string.format("%s#%d %.1fm at %.0fs", j.sec, j.id, j.d, j.t) end
		end
	end
	return counted == 0, string.format("%d jumps after the first %d s (%d in all) [%s]", counted, JUMP_SETTLE / 1000,
		#jumps, table.concat(list, "; "))
end

------------------------------------------------------------------ the host's part
local function ask(step, name, ...) coop_main.send("qa", step, name, ...) end

local function census(step)
	local c = db.actor:position()
	local list = {}
	for _, o in ipairs(creatures_near(c, CENSUS_RADIUS)) do
		local p = o:position()
		list[#list + 1] = string.format("%d,%s,%.1f,%.1f,%d", o:id(), o:section(), p.x, p.z, o:alive() and 1 or 0)
	end
	record(step .. "host", true, #list .. " creatures within " .. CENSUS_RADIUS .. " m of the host")
	ask(step, "census", string.format("%.1f", c.x), string.format("%.1f", c.y), string.format("%.1f", c.z), table.concat(list, ";"))
end

-- the guest's answers: kept, and checked against the host where the step says how
coop_main.on_event("qa_r", function(a)
	if not active or not is_host then return end
	local step, ok, detail = a[1], a[2] == "1", a[3] or ""
	local check = ctx.expect[step]
	if check then
		ctx.expect[step] = nil
		local good, why = check(ok, detail)
		record(step, good, why)
	else
		record(step, ok, "guest: " .. detail)
	end
end)

coop_main.on_event("qa_ready", function()
	if active and is_host then guest_ready = true end
end)

