	{ 157, function() census("census2") end },
	{ 158, function()
		announce("ШАГ 8. Оба переходят на ферму к механику.\\nЗеркало должно расставить у гостя тех же людей и монстров, что у хоста; через 18 с — перепись.", 12)
		local center, lv, gv = village(FARM)
		local dir, side = open_direction(center)
		local me = aside(center, 0, 0)
		local guest_pos = aside(center, side.x * 2.5, side.z * 2.5)
		local spot = vector():set(center.x + dir.x * 8, center.y, center.z + dir.z * 8)
		jump(me)
		after(1500, function() look_at(spot) end)
		local f = function(p) return string.format("%.2f", p.x), string.format("%.2f", p.y), string.format("%.2f", p.z) end
		local gx, gy, gz = f(guest_pos)
		local sx, sy, sz = f(spot)
		ask("8go", "goto", gx, gy, gz, sx, sy, sz)
		record("8", true, string.format("at the farm %.0f m from the village", center:distance_to(village())))
	end },
	{ 176, function() census("census3") end },
	{ 177, function() ask("jumps", "jumps") end },
	{ 178, function()
		-- the same clock (the guest's runs at real speed while it is ahead)
		local hm = level.get_time_hours() * 60 + level.get_time_minutes()
		ctx.expect["clock"] = function(ok, detail)
			local h, m = detail:match(" at (%d+):(%d+)")
			local d = h and math.abs((tonumber(h) * 60 + tonumber(m)) - hm) or 999
			return ok and d <= 2, string.format("host %02d:%02d, guest %s (%d min apart)", math.floor(hm / 60), hm % 60, detail, d)
		end
		ask("clock", "weather")
	end },
	{ 182, function()
		announce("ШАГ 14. Бой: в 8 м появляются бандиты и стреляют по гостю.\\nУ ХОСТА они стреляют и по гостю (модели напарника). У ГОСТЯ — тоже по гостю; урон гостю приходит от хоста.", 14)
		-- in the open, where both see them (behind a barn they would see no one and fire at no one)
		local me = db.actor:position()
		local pos, lv = ahead(15)
		for i = 0, 15 do
			local a = i * math.pi / 8
			local dir = vector():set(math.cos(a), 0, math.sin(a))
			if walkable(me, dir, 9) then
				pos, lv = aside(me, dir.x * 8, dir.z * 8)
				break
			end
		end
		look_at(pos)
		ask("14look", "look", string.format("%.2f", pos.x), string.format("%.2f", pos.y), string.format("%.2f", pos.z))
		local gv = db.actor:game_vertex_id()
		local sq = alife_create("bandit_sim_squad_novice", pos, lv, gv)
		if sq then
			sq:create_npc(nil, pos, lv, gv)
			sq:set_squad_relation()
			ctx.bandits = sq.id
			ctx.bandit_ids = {}
			for m in sq:squad_members() do ctx.bandit_ids[m.id] = true end
			RegisterScriptCallback("on_enemy_eval", bandits_ignore_host)
		end
		record("14spawn", sq ~= nil, sq and ("bandits " .. sq.id) or "no squad")
		-- how the bandits are doing: alive, how far from the host and the guest's puppet, whom they fight
		for _, ms in ipairs({ 8000, 15000, 22000 }) do
			after(ms, function()
				local squad = ctx.bandits and alife_object(ctx.bandits)
				local pid = coop_player.get_puppet_id()
				local puppet = pid and level.object_by_id(pid)
				local out = {}
				if squad then
					for m in squad:squad_members() do
						local o = level.object_by_id(m.id)
						if o then
							local e = o:best_enemy()
							out[#out + 1] = string.format("%d %s host %.0f m guest %.0f m enemy %s", m.id,
								o:alive() and "alive" or "dead", o:position():distance_to(db.actor:position()),
								puppet and o:position():distance_to(puppet:position()) or -1,
								e and (e:id() == AC_ID and "host" or (e:id() == pid and "guest" or e:section())) or "-")
						end
					end
				end
				coop_main.log(string.format("QA bandits at %d s: %s", ms / 1000, table.concat(out, "; ")))
			end)
		end
	end },
	{ 204, function()
		-- the host: someone fights the guest's puppet, and its hits went to the guest
		local pid = coop_player.get_puppet_id()
		local n, on_guest = 0, 0
		for _, st in pairs(db.storage) do
			local o = st.object
			local e = o and o:alive() and IsStalker(o) and o:best_enemy()
			if e then
				n = n + 1
				if e:id() == pid then on_guest = on_guest + 1 end
			end
		end
		local sent, _, _, fought = coop_combat.counts()
		record("14host", fought > 0, string.format("the guest was fought %d times; now %d fighting, %d of them the guest",
			fought, n, on_guest))
		record("14sent", sent > 0, string.format("%d hits on the guest's puppet sent to the guest", sent))
		ask("14", "combat")
	end },
