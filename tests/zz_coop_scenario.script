	end },
	{ 212, function()
		announce("ШАГ 15. Хост бросает на землю аптечку.\\nУ ГОСТЯ она должна лежать там же.", 8)
		alife_create_item("medkit", db.actor)
		after(1500, function()
			local list = on_actor("medkit")
			local item = list[#list]
