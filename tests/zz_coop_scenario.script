	{ 218, function()
		local p = ctx.drop_pos
		if not p then record("15", false, "the medkit is not on the ground") return end
		ctx.expect["15"] = function(ok, detail)
			return ok and (tonumber(detail) or 0) >= 1, "guest's medkits on that spot: " .. detail
		end
		ask("15", "ground", "medkit", string.format("%.2f", p.x), string.format("%.2f", p.y), string.format("%.2f", p.z))
	end },
	{ 220, function()
		local p = ctx.drop_pos
		if not p then return end
		announce("ШАГ 16. Гость поднимает аптечку с земли.\\nУ ХОСТА она должна исчезнуть.", 8)
		ctx.ground16 = #ground_items("medkit", p, 3)
		ask("16take", "pickup", "medkit", string.format("%.2f", p.x), string.format("%.2f", p.y), string.format("%.2f", p.z))
	end },
	{ 226, function()
		local p = ctx.drop_pos
		if not p then return end
		local n = #ground_items("medkit", p, 3)
		record("16", n == (ctx.ground16 or 1) - 1, string.format("host's medkits on that spot %d -> %d", ctx.ground16 or -1, n))
	end },
	{ 228, function()
		announce("ШАГ 17. Гость бросает на землю бинт.\\nУ ХОСТА он должен появиться рядом с гостем.", 8)
		local pid = coop_player.get_puppet_id()
		local puppet = pid and level.object_by_id(pid)
		ctx.puppet_pos = puppet and vector():set(puppet:position())
		ctx.bandages0 = ctx.puppet_pos and #ground_items("bandage", ctx.puppet_pos, 6) or 0
		ask("17drop", "drop_new", "bandage")
	end },
	{ 235, function()
		local p = ctx.puppet_pos
		if not p then record("17", false, "no guest's puppet here") return end
		local n = #ground_items("bandage", p, 6)
		record("17", n == ctx.bandages0 + 1, string.format("bandages by the guest at the host %d -> %d", ctx.bandages0, n))
	end },
	{ 237, function()
		announce("ШАГ 18. Хост убивает сталкера рядом.\\nЧерез несколько секунд вещи на трупе у гостя — те же, что у хоста.", 10)
		local me, best, npc = db.actor:position(), 60, nil
		for id, st in pairs(db.storage) do
			local o = st.object
			if o and IsStalker(o) and o:alive() and id ~= AC_ID and not coop_player.is_puppet(id) and not get_object_story_id(id)
				and o:position():distance_to(me) < best then
				npc, best = o, o:position():distance_to(me)
			end
		end
		if not npc then record("18", false, "no stalker near") return end
		ctx.body = npc:id()
		npc:kill(db.actor)
		record("18kill", true, string.format("%s killed, %.0f m away", npc:section(), best))
	end },
	{ 247, function()
		local body = ctx.body and level.object_by_id(ctx.body)
		if not body then return end
		local list = {}
		body:iterate_inventory(function(_, o) if o then list[#list + 1] = o:section() end end, body)
		table.sort(list)
		local mine = table.concat(list, ",")
		ctx.expect["18"] = function(ok, detail)
			return ok and detail == mine, string.format("body: host [%s], guest [%s]", mine, detail)
		end
		ask("18", "body", tostring(ctx.body))
	end },
	{ 252, function()
		announce("ТЕСТ ЗАКОНЧЕН. Итоги — в coop_qa.txt обеих игр.", 15)
		record("end", true, "done")
	end },
}

------------------------------------------------------------------ the clock
local function actor_on_update()
	if not active then return end
	local now = time_global()
	local keep = {}
	for _, l in ipairs(later) do
		if now >= l[1] then pcall(l[2]) else keep[#keep + 1] = l end
	end
	later = keep
	-- the host makes it noon and clear, so the steps can be seen (the guest follows the host's time and weather)
	if not ctx.day_set and ctx.first_at and now > ctx.first_at + 3000 and coop_main.role == "host" then
		ctx.day_set = true
		local h, m = level.get_time_hours(), level.get_time_minutes()
		if h >= 19 or h < 7 then
			level.change_game_time(0, (12 - h - 1) % 24, 60 - m)
		end
		level.set_weather("w_clear1", true)
		-- a jump: the guest's sky follows at once
		if coop_world.weather_jumped then coop_world.weather_jumped() end
		coop_main.log(string.format("QA day: %02d:%02d -> %02d:%02d, clear", h, m, level.get_time_hours(),
			level.get_time_minutes()))
	end
	if not (ready_at and now > ready_at and coop_main.connected) then return end
	is_host = coop_main.role == "host"
	if not is_host then
		if ctx.go then watch_jumps(now) end
		-- the guest says it is up until the host starts
		if not ctx.go and (not ctx.ready_sent or now > ctx.ready_sent + 3000) then
			ctx.ready_sent = now
			coop_main.send("qa_ready")
		end
		return
	end
	if not guest_ready then return end
	if not go_sent then
		go_sent = true
		coop_main.send("qa_go")
		started_at = now
	end
	while STEPS[next_step] and now >= started_at + STEPS[next_step][1] * 1000 do
		local s = STEPS[next_step]
		next_step = next_step + 1
		local ok, err = pcall(s[2])
		if not ok then record("step" .. tostring(next_step - 1), false, "script: " .. tostring(err)) end
	end
end

local function actor_on_first_update()
	ctx.first_at = time_global()
	-- the guest's character, the host's spawns and the mirror settle first
	ready_at = time_global() + 20000
	if not PANEL and get_hud() then
		PANEL = UICoopQa()
		get_hud():AddDialogToRender(PANEL)
	end
end

local function actor_on_net_destroy()
	if PANEL and get_hud() then get_hud():RemoveDialogToRender(PANEL) end
	PANEL = nil
end

function on_game_start()
	local f = io.open(app("coop_scenario.txt"), "r")
	active = f ~= nil
	if f then f:close() end
	if not active then return end
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
end
