-- dev only: when appdata\coop_spawntest.txt exists, the HOST spawns a squad next to the actor 20 s after the
-- partner connects and releases it 15 s later. Steps go to coop_log.txt.
local active, t0, squad_id, done = false, nil, nil, {}

local function update()
	if not (active and coop_main.is_host() and coop_main.connected) then return end
	t0 = t0 or time_global()
	local t = (time_global() - t0) / 1000
	if t > 20 and not done.spawn then
		done.spawn = true
		local a = db.actor
		local sq = alife_create("stalker_sim_squad_novice", a:position(), a:level_vertex_id(), a:game_vertex_id())
		sq:create_npc(nil, a:position(), a:level_vertex_id(), a:game_vertex_id())
		squad_id = sq.id
		local n = 0
		for k in sq:squad_members() do n = n + 1 end
		coop_main.log("SPAWNTEST spawned squad id=" .. sq.id .. " members=" .. n)
	end
	if t > 25 and not done.art then
		done.art = true
		local a = db.actor
		local art = alife_create("af_medusa", a:position(), a:level_vertex_id(), a:game_vertex_id())
		coop_main.log("SPAWNTEST artefact id=" .. tostring(art and art.id))
		local box
		for id, st in pairs(db.storage) do
			local o = st.object
			if o and IsInvbox(o) and o:position():distance_to(a:position()) < 60 then box = o break end
		end
		local item = box and alife_create_item("bandage", box)
		coop_main.log("SPAWNTEST box item " .. tostring(item and item.id) .. " in box " .. tostring(box and box:id()))
	end
	if t > 30 and not done.objects then
		done.objects = true
		local a = db.actor
		local door, crate, dd, cd = nil, nil, 1e9, 1e9
		for id, st in pairs(db.storage) do
			local o = st.object
			if o then
				local d = o:position():distance_to(a:position())
				if st.ph_door and st.ph_door.door_action and d < dd then door, dd = st.ph_door.door_action, d end
				if o:clsid() == clsid.obj_phys_destroyable and o:alive() and d < cd then crate, cd = o, d end
			end
		end
		coop_main.log(string.format("SPAWNTEST door %s at %.0f m, crate %s at %.0f m",
			tostring(door and door.object:id()), dd, tostring(crate and crate:id()), cd))
		if door then door:open_door(true) end
		if crate then
			local h = hit(); h.type = hit.explosion; h.power = 1000; h.impulse = 0; h.draftsman = a
			h.direction = vector():set(0, -1, 0); crate:hit(h)
		end
	end
	if t > 40 and not done.rest then
		done.rest = true
		local a = db.actor
		-- player stash from a backpack, as item_backpack does it
		local se = alife_create("inv_backpack", a:position(), a:level_vertex_id(), a:game_vertex_id())
		if se then SendScriptCallback("actor_on_stash_create", { stash_id = se.id, stash_name = "Тест", stash_section = "itm_backpack" }) end
		coop_main.log("SPAWNTEST player stash " .. tostring(se and se.id))
		-- reward stash on the box used before
		local box
		for id, st in pairs(db.storage) do local o = st.object; if o and IsInvbox(o) then box = o break end end
		if box then treasure_manager.set_random_stash(false, "тест", nil, box:id()) end
		coop_main.log("SPAWNTEST reward stash on " .. tostring(box and box:id()) .. " content=" .. tostring(box and treasure_manager.caches[box:id()]))
		-- surrender: nearest living stalker
		local npc
		for id, st in pairs(db.storage) do local o = st.object; if o and IsStalker(o) and o:alive() and id ~= AC_ID and not coop_player.is_puppet(id) then npc = o break end end
		if npc then db.storage[npc:id()].victim_surrender = AC_ID end
		coop_main.log("SPAWNTEST surrender " .. tostring(npc and npc:id()))
		-- push door: swing the nearest hinge
		local door, dd = nil, 1e9
		level.iterate_nearest(a:position(), 40, function(o)
			local ok, j = pcall(function() local sh = o:get_physics_shell(); return sh and sh:get_joint_by_bone_name("door") end)
			if ok and j and not (db.storage[o:id()] and db.storage[o:id()].ph_door) then
				local d = o:position():distance_to(a:position()); if d < dd then door, dd = o, d end
			end
		end)
		coop_main.log("SPAWNTEST push door " .. tostring(door and door:id()))
		if door then
			local j = door:get_physics_shell():get_joint_by_bone_name("door")
			coop_main.log("SPAWNTEST push door angle before " .. string.format("%.2f", j:get_axis_angle(0)))
			j:set_max_force_and_velocity(3000, 2, 0)
			CreateTimeEvent("coop_spawntest", "door_stop", 1.5, function()
				j:set_max_force_and_velocity(0, 0, 0)
				coop_main.log("SPAWNTEST push door angle after " .. string.format("%.2f", j:get_axis_angle(0)))
				return true
			end)
		end
	end
	if t > 35 and not done.release and squad_id then
		done.release = true
		local se = alife_object(squad_id)
		coop_main.log("SPAWNTEST releasing squad " .. tostring(se and se.id))
		if se then alife_release(se) end
	end
end

function on_game_start()
	local f = io.open(getFS():update_path("$app_data_root$", "coop_spawntest.txt"), "r")
	if f then f:close() active = true end
	RegisterScriptCallback("actor_on_update", function() pcall(update) end)
end
