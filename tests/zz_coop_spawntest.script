-- dev only: when appdata\coop_spawntest.txt exists, the HOST spawns a squad next to the actor 20 s after the
-- partner connects and releases it 15 s later. Steps go to coop_log.txt.
local active, t0, squad_id, done = false, nil, nil, {}

local function update()
	if not (active and coop_main.is_host() and coop_main.connected) then return end
	t0 = t0 or time_global()
	local t = (time_global() - t0) / 1000
	if t > 20 and not done.spawn then
		done.spawn = true
		local a = db.actor
		local sq = alife_create("stalker_sim_squad_novice", a:position(), a:level_vertex_id(), a:game_vertex_id())
		sq:create_npc(nil, a:position(), a:level_vertex_id(), a:game_vertex_id())
		squad_id = sq.id
		local n = 0
		for k in sq:squad_members() do n = n + 1 end
		coop_main.log("SPAWNTEST spawned squad id=" .. sq.id .. " members=" .. n)
	end
	if t > 25 and not done.art then
		done.art = true
		local a = db.actor
		local art = alife_create("af_medusa", a:position(), a:level_vertex_id(), a:game_vertex_id())
		coop_main.log("SPAWNTEST artefact id=" .. tostring(art and art.id))
		local box
		for id, st in pairs(db.storage) do
			local o = st.object
			if o and IsInvbox(o) and o:position():distance_to(a:position()) < 60 then box = o break end
		end
		local item = box and alife_create_item("bandage", box)
		coop_main.log("SPAWNTEST box item " .. tostring(item and item.id) .. " in box " .. tostring(box and box:id()))
	end
	if t > 35 and not done.release and squad_id then
		done.release = true
		local se = alife_object(squad_id)
		coop_main.log("SPAWNTEST releasing squad " .. tostring(se and se.id))
		if se then alife_release(se) end
	end
end

function on_game_start()
	local f = io.open(getFS():update_path("$app_data_root$", "coop_spawntest.txt"), "r")
	if f then f:close() active = true end
	RegisterScriptCallback("actor_on_update", function() pcall(update) end)
end
